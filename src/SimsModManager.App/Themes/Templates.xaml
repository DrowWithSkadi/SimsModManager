<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:SimsModManager.App.Controls"
                    xmlns:vm="clr-namespace:SimsModManager.App.ViewModels"
                    xmlns:b="clr-namespace:SimsModManager.App.Behaviors">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Converters.xaml" />
        <ResourceDictionary Source="Theme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ═══════════ Превью мода (картинка или значок) ═══════════ -->
    <DataTemplate x:Key="ModPreview" DataType="{x:Type vm:ModItemViewModel}">
        <Grid>
            <Border x:Name="Placeholder" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource B.Border}" Background="{DynamicResource B.Surface}">
                <ctl:IconView x:Name="PlaceholderIcon" Data="{StaticResource Icon.Image}" Foreground="{DynamicResource B.TextMuted}"
                              Width="14" Height="14" />
            </Border>
            <Border x:Name="Pic" CornerRadius="4" Background="{DynamicResource B.Control}" Visibility="Collapsed" ClipToBounds="True">
                <Grid>
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                    <!-- Выключенный мод — картинка плавно становится чёрно-белой -->
                    <Image x:Name="GrayPic" Source="{Binding Thumbnail, Converter={StaticResource Grayscale}}" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality" Opacity="0" />
                </Grid>
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsScriptOnly}" Value="True">
                <Setter TargetName="PlaceholderIcon" Property="Data" Value="{StaticResource Icon.FileCode}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsTray}" Value="True">
                <Setter TargetName="PlaceholderIcon" Property="Data" Value="{StaticResource Icon.House}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="GrayPic" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="GrayPic" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                <Setter TargetName="Pic" Property="Visibility" Value="Visible" />
                <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Pic" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ═══════════ Метки типа ═══════════ -->
    <DataTemplate x:Key="ModTags" DataType="{x:Type vm:ModItemViewModel}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Красный флажок: проверка нашла проблему. Подсказка — причина, клик — экран проверки. -->
            <Button Cursor="Hand" Margin="0,0,6,0" ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="30000"
                    Command="{Binding DataContext.OpenHealthCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    b:Anim.Show="{Binding HasHealthFlag}" b:Anim.Offset="0">
                <Button.ToolTip>
                    <StackPanel MaxWidth="320">
                        <TextBlock Text="Проблема с модом" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding HealthFlag}" TextWrapping="Wrap" />
                        <TextBlock Text="Нажмите, чтобы решить" Opacity="0.6" Margin="0,6,0,0" />
                    </StackPanel>
                </Button.ToolTip>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Width="20" Height="20" CornerRadius="5" Background="{DynamicResource B.Error}">
                            <ctl:IconView Data="{StaticResource Icon.Flag}" Foreground="White" Width="12" Height="12" StrokeThickness="2.2" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Border Background="Transparent" Padding="2" Margin="0,0,6,0" ToolTip="{Binding ProblemsText}" ToolTipService.InitialShowDelay="200"
                    Visibility="{Binding ShowOldWarning, Converter={StaticResource BoolToVisibility}}">
                <ctl:IconView Data="{StaticResource Icon.TriangleAlert}" Foreground="{DynamicResource B.Warning}" Width="14" Height="14" />
            </Border>
            <!-- «Нужно: Времена года» — жёлтая, если такого дополнения у пользователя нет -->
            <Border Margin="0,0,4,0" ToolTip="{Binding RequiredPacksTooltip}" ToolTipService.InitialShowDelay="200"
                    Visibility="{Binding HasRequiredPacks, Converter={StaticResource BoolToVisibility}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Tag}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MissingPack}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource B.WarningSubtle}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding RequiredPacksLabel}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TagText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MissingPack}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource B.Warning}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
            <Border Style="{StaticResource Tag}" Visibility="{Binding ShowCategory, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource TagText}" Text="{Binding CategoryLabel}" />
            </Border>
            <Border Style="{StaticResource Tag}" Margin="4,0,0,0" ToolTip="Настройки вещей изменены в менеджере. Оригинал сохранён."
                    Visibility="{Binding IsModified, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource TagText}" Text="Изменён" Foreground="{DynamicResource B.Accent}" />
            </Border>
            <Border Style="{StaticResource Tag}" Background="{DynamicResource B.AccentSubtle}" Margin="4,0,0,0"
                    Visibility="{Binding ShowScriptBadge, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource TagText}" Text="Скрипт" Foreground="{DynamicResource B.Accent}" />
            </Border>
            <Border Style="{StaticResource Tag}" Margin="4,0,0,0"
                    Visibility="{Binding IsEnabled, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Style="{StaticResource TagText}" Text="Выключен" Foreground="{DynamicResource B.TextMuted}" />
            </Border>
        </StackPanel>
    </DataTemplate>

    <!-- ═══════════ Строка мода (вид «список», высота 48) ═══════════ -->
    <DataTemplate x:Key="ModRow" DataType="{x:Type vm:ModItemViewModel}">
        <Grid b:Anim.Offset="0" b:Anim.Appear="{Binding IsNew}" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Вспышка после установки -->
            <Border x:Name="Flash" Grid.ColumnSpan="5" Margin="-12,0" Background="{DynamicResource B.AccentSubtle}" Opacity="0" IsHitTestVisible="False" />

            <!-- Галочка выбора — выезжает, когда выбрано больше одного мода -->
            <Border x:Name="SelectHolder" Width="0" ClipToBounds="True" VerticalAlignment="Center">
                <CheckBox Style="{StaticResource SelectBox}" HorizontalAlignment="Left"
                          IsChecked="{Binding IsSelected}" />
            </Border>

            <Grid Grid.Column="1" Width="36" Height="36" Margin="0,0,12,0">
                <ContentPresenter x:Name="Preview" Content="{Binding}" ContentTemplate="{StaticResource ModPreview}" />
                <!-- Галочка «установлен» — выпрыгивает с пружинкой и исчезает -->
                <Border x:Name="NewBadge" Width="16" Height="16" CornerRadius="8" Background="{DynamicResource B.Accent}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-4" Opacity="0"
                        RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                    <Border.RenderTransform><ScaleTransform ScaleX="0" ScaleY="0" /></Border.RenderTransform>
                    <ctl:IconView Data="{StaticResource Icon.Check}" Foreground="{DynamicResource B.OnAccent}" Width="10" Height="10" StrokeThickness="2.6" />
                </Border>
            </Grid>

            <StackPanel x:Name="Texts" Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                <TextBlock Text="{Binding DetailsText}" FontSize="10" Foreground="{DynamicResource B.TextMuted}" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <ContentPresenter x:Name="Tags" Grid.Column="3" Content="{Binding}" ContentTemplate="{StaticResource ModTags}" Margin="12,0,16,0" />

            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource Btn.Icon}" ctl:Btn.Icon="{StaticResource Icon.FolderOpen}" ToolTip="Показать в проводнике"
                        Command="{Binding DataContext.OpenModLocationCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}" />
                <Button Style="{StaticResource Btn.Icon}" ctl:Btn.Icon="{StaticResource Icon.Trash2}" ToolTip="Удалить в корзину" Margin="8,0,8,0"
                        Command="{Binding DataContext.DeleteModCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}" />
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsEnabled}" ToolTip="Включить / выключить мод" />
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                <Setter TargetName="Texts" Property="Opacity" Value="0.5" />
                <Setter TargetName="Preview" Property="Opacity" Value="0.7" />
                <Setter TargetName="Tags" Property="Opacity" Value="0.6" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsNew}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <!-- Вспышка цвета акцента -->
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Flash" Storyboard.TargetProperty="Opacity">
                                <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="1" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="1" />
                                <EasingDoubleKeyFrame KeyTime="0:0:1.7" Value="0">
                                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction>
                                </EasingDoubleKeyFrame>
                            </DoubleAnimationUsingKeyFrames>
                            <!-- Галочка: пружинка 0 → 1, держится и тает -->
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NewBadge" Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.1" Value="1" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:1.4" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="NewBadge" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             From="0" To="1" BeginTime="0:0:0.1" Duration="0:0:0.5">
                                <DoubleAnimation.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="NewBadge" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             From="0" To="1" BeginTime="0:0:0.1" Duration="0:0:0.5">
                                <DoubleAnimation.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding DataContext.IsMultiSelect, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SelectHolder" Storyboard.TargetProperty="Width" To="28" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SelectHolder" Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ═══════════ Плитка мода (вид «плитки») ═══════════ -->
    <DataTemplate x:Key="ModTile" DataType="{x:Type vm:ModItemViewModel}">
        <Grid b:Anim.Appear="{Binding IsNew}" Width="176">
            <Grid.RowDefinitions>
                <RowDefinition Height="132" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- Вспышка после установки (на всю плитку, за содержимым) -->
            <Border x:Name="Flash" Grid.RowSpan="3" Margin="-10" CornerRadius="8" Background="{DynamicResource B.AccentSubtle}"
                    BorderBrush="{DynamicResource B.Accent}" BorderThickness="1" Opacity="0" IsHitTestVisible="False" />
            <ContentPresenter x:Name="Preview" Content="{Binding}" ContentTemplate="{StaticResource ModPreview}" />
                <!-- Галочка «установлен» — выпрыгивает с пружинкой и исчезает -->
                <Border x:Name="NewBadge" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource B.Accent}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" Opacity="0"
                        RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                    <Border.RenderTransform><ScaleTransform ScaleX="0" ScaleY="0" /></Border.RenderTransform>
                    <ctl:IconView Data="{StaticResource Icon.Check}" Foreground="{DynamicResource B.OnAccent}" Width="15" Height="15" StrokeThickness="2.6" />
                </Border>
            <CheckBox Style="{StaticResource SelectBox}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                      IsChecked="{Binding IsSelected}"
                      Visibility="{Binding DataContext.IsMultiSelect, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock x:Name="Title" Grid.Row="1" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}"
                       TextTrimming="CharacterEllipsis" Margin="0,10,0,6" ToolTip="{Binding Name}" />
            <Grid Grid.Row="2">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ModTags}" HorizontalAlignment="Left" />
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsEnabled}" HorizontalAlignment="Right" />
            </Grid>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                <Setter TargetName="Title" Property="Opacity" Value="0.5" />
                <Setter TargetName="Preview" Property="Opacity" Value="0.7" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsNew}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <!-- Вспышка цвета акцента -->
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Flash" Storyboard.TargetProperty="Opacity">
                                <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="1" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="1" />
                                <EasingDoubleKeyFrame KeyTime="0:0:1.7" Value="0">
                                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseInOut" /></EasingDoubleKeyFrame.EasingFunction>
                                </EasingDoubleKeyFrame>
                            </DoubleAnimationUsingKeyFrames>
                            <!-- Галочка: пружинка 0 → 1, держится и тает -->
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NewBadge" Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.1" Value="1" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:1.4" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="NewBadge" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             From="0" To="1" BeginTime="0:0:0.1" Duration="0:0:0.5">
                                <DoubleAnimation.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="NewBadge" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             From="0" To="1" BeginTime="0:0:0.1" Duration="0:0:0.5">
                                <DoubleAnimation.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ═══════════ Контейнеры: подсветка при наведении и выборе, анимация удаления ═══════════ -->
    <Style x:Key="ModRowContainer" TargetType="ListBoxItem">
        <Setter Property="b:Anim.Wave" Value="True" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border Background="{DynamicResource B.Surface}" BorderBrush="{DynamicResource B.Hover}" BorderThickness="0,0,0,1" />
                        <Border x:Name="HoverBg" Background="{DynamicResource B.Control}" Opacity="0" Margin="0,0,0,1" />
                        <Border x:Name="SelBg" Background="{DynamicResource B.AccentSubtle}" BorderBrush="{DynamicResource B.Accent}"
                                BorderThickness="1" CornerRadius="2" Opacity="0" />
                        <!-- Полоска акцента слева выезжает при наведении -->
                        <Border x:Name="HoverBar" Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="1.5"
                                Background="{DynamicResource B.Accent}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleY="0.3" /></Border.RenderTransform>
                        </Border>
                        <ContentPresenter x:Name="Body" Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                            <ContentPresenter.RenderTransform><TranslateTransform /></ContentPresenter.RenderTransform>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="HoverBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="HoverBar" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="3" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetName="HoverBar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="HoverBar" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="0.3" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="0" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding DataContext.IsMultiSelect, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelBg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsRemoving}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetProperty="Height" To="0" Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ModTileContainer" TargetType="ListBoxItem">
        <Setter Property="b:Anim.Wave" Value="True" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid x:Name="Card">
                        <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                        <!-- Тень появляется, когда плитка приподнимается -->
                        <Border x:Name="Shadow" Background="{DynamicResource B.Surface}" CornerRadius="8" Opacity="0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.45" Color="Black" />
                            </Border.Effect>
                        </Border>
                        <Border Background="{DynamicResource B.Surface}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1" CornerRadius="8" />
                        <Border x:Name="HoverBg" Background="{DynamicResource B.Control}" BorderBrush="{DynamicResource B.BorderHover}" BorderThickness="1" CornerRadius="8" Opacity="0" />
                        <Border x:Name="SelBg" Background="{DynamicResource B.AccentSubtle}" BorderBrush="{DynamicResource B.Accent}" BorderThickness="1"
                                CornerRadius="8" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         To="-4" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         To="0" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding DataContext.IsMultiSelect, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="SelBg" Property="Opacity" Value="1" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsRemoving}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Строка-заглушка, пока читаем папку Mods (мягко «дышит») -->
    <Style x:Key="SkeletonBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource B.Control}" />
        <Setter Property="CornerRadius" Value="4" />
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.45" Duration="0:0:0.8" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════ Итог установки ═══════════ -->
    <DataTemplate x:Key="InstallResultItem" DataType="{x:Type vm:InstallResultViewModel}">
        <Border x:Name="Card" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8" b:Anim.Appear="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ctl:IconView x:Name="Icon" Data="{Binding Icon}" Foreground="{DynamicResource B.Accent}" VerticalAlignment="Top" Margin="0,2,20,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource T.Strong}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="Msg" Text="{Binding Message}" FontSize="11" Foreground="{DynamicResource B.Accent}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Skipped">
                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource B.TextSecondary}" />
                <Setter TargetName="Msg" Property="Foreground" Value="{DynamicResource B.TextSecondary}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Failed">
                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource B.Error}" />
                <Setter TargetName="Msg" Property="Foreground" Value="{DynamicResource B.Error}" />
                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource B.ErrorBorder}" />
                <Setter TargetName="Card" Property="Background" Value="{DynamicResource B.ErrorCard}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ═══════════ Уведомление ═══════════ -->
    <DataTemplate x:Key="ToastItem" DataType="{x:Type vm:ToastViewModel}">
        <Border Style="{StaticResource Card}" Background="{DynamicResource B.Popup}" Padding="14,0,6,0" Height="40" Margin="0,8,0,0"
                b:Anim.Show="{Binding IsVisible}" b:Anim.Appear="True" MinWidth="320" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.4" Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ctl:IconView Data="{Binding Icon}" Foreground="{DynamicResource B.Accent}" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="12" Foreground="{DynamicResource B.Text}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="460" />
                <Button Grid.Column="2" Style="{StaticResource Btn.Link}" Content="Отменить" Command="{Binding UndoCommand}" Margin="16,0,0,0"
                        Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}" />
                <Button Grid.Column="3" Style="{StaticResource Btn.IconGhost}" ctl:Btn.Icon="{StaticResource Icon.X}" Command="{Binding CloseCommand}"
                        Margin="4,0,0,0" Width="24" Height="24" />
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
