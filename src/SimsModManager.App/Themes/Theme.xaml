<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:SimsModManager.App.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ═══════════ Цвета (UI-kit «Основа спокойной библиотеки») ═══════════ -->
    <Color x:Key="C.Background">#191919</Color>
    <Color x:Key="C.Surface">#222222</Color>
    <Color x:Key="C.Control">#2B2B2B</Color>
    <Color x:Key="C.Hover">#333333</Color>
    <Color x:Key="C.Pressed">#3E3E3E</Color>
    <Color x:Key="C.Border">#414141</Color>
    <Color x:Key="C.Text">#F3F3F1</Color>
    <Color x:Key="C.TextSecondary">#B8B8B4</Color>
    <Color x:Key="C.TextMuted">#858582</Color>
    <Color x:Key="C.Accent">#77E1C7</Color>
    <Color x:Key="C.AccentHover">#8EE8D2</Color>
    <Color x:Key="C.AccentSubtle">#243C35</Color>
    <Color x:Key="C.OnAccent">#0F2A23</Color>
    <Color x:Key="C.Error">#F18B8B</Color>
    <Color x:Key="C.ErrorSubtle">#3A2627</Color>
    <Color x:Key="C.ErrorBorder">#6E3B3C</Color>
    <Color x:Key="C.Warning">#E7BE78</Color>
    <Color x:Key="C.WarningSubtle">#3A3224</Color>
    <Color x:Key="C.WarningBorder">#6A5733</Color>
    <Color x:Key="C.Overlay">#D9101010</Color>
    <Color x:Key="C.CloseHover">#C42B1C</Color>

    <SolidColorBrush x:Key="B.Background" Color="{StaticResource C.Background}" />
    <SolidColorBrush x:Key="B.Surface" Color="{StaticResource C.Surface}" />
    <SolidColorBrush x:Key="B.Control" Color="{StaticResource C.Control}" />
    <SolidColorBrush x:Key="B.Hover" Color="{StaticResource C.Hover}" />
    <SolidColorBrush x:Key="B.Pressed" Color="{StaticResource C.Pressed}" />
    <SolidColorBrush x:Key="B.Border" Color="{StaticResource C.Border}" />
    <SolidColorBrush x:Key="B.Text" Color="{StaticResource C.Text}" />
    <SolidColorBrush x:Key="B.TextSecondary" Color="{StaticResource C.TextSecondary}" />
    <SolidColorBrush x:Key="B.TextMuted" Color="{StaticResource C.TextMuted}" />
    <SolidColorBrush x:Key="B.Accent" Color="{StaticResource C.Accent}" />
    <SolidColorBrush x:Key="B.AccentSubtle" Color="{StaticResource C.AccentSubtle}" />
    <SolidColorBrush x:Key="B.OnAccent" Color="{StaticResource C.OnAccent}" />
    <SolidColorBrush x:Key="B.Error" Color="{StaticResource C.Error}" />
    <SolidColorBrush x:Key="B.ErrorSubtle" Color="{StaticResource C.ErrorSubtle}" />
    <SolidColorBrush x:Key="B.ErrorBorder" Color="{StaticResource C.ErrorBorder}" />
    <SolidColorBrush x:Key="B.Warning" Color="{StaticResource C.Warning}" />
    <SolidColorBrush x:Key="B.WarningSubtle" Color="{StaticResource C.WarningSubtle}" />
    <SolidColorBrush x:Key="B.WarningBorder" Color="{StaticResource C.WarningBorder}" />
    <SolidColorBrush x:Key="B.Overlay" Color="{StaticResource C.Overlay}" />
    <SolidColorBrush x:Key="B.DropOverlay" Color="#E6141414" />

    <!-- ═══════════ Шрифт и текст ═══════════ -->
    <FontFamily x:Key="Font.Ui">pack://application:,,,/Fonts/#Inter, Segoe UI</FontFamily>

    <Style x:Key="T.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
    </Style>
    <Style x:Key="T.Page" TargetType="TextBlock" BasedOn="{StaticResource T.Title}">
        <Setter Property="FontSize" Value="24" />
    </Style>
    <Style x:Key="T.Section" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
    </Style>
    <Style x:Key="T.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
    </Style>
    <Style x:Key="T.Strong" TargetType="TextBlock" BasedOn="{StaticResource T.Body}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="T.Secondary" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource B.TextSecondary}" />
    </Style>
    <Style x:Key="T.Muted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
    </Style>
    <Style x:Key="T.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
    </Style>

    <!-- ═══════════ Иконка ═══════════ -->
    <Style TargetType="ctl:IconView">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctl:IconView">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Data="{TemplateBinding Data}" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="{TemplateBinding StrokeThickness}"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════ Кнопки ═══════════
         Наведение и нажатие — полупрозрачный слой поверх фона, плавно 120 мс. -->
    <Style x:Key="Btn.Base" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Background" Value="{StaticResource B.Control}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" />
                        <Border x:Name="Overlay" Background="White" CornerRadius="6" Opacity="0" Margin="1" />
                        <Border x:Name="Focus" BorderBrush="{StaticResource B.Accent}" BorderThickness="1.5" CornerRadius="6"
                                Margin="-2" Opacity="0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="{TemplateBinding Padding}">
                            <ctl:IconView x:Name="Icon" Data="{TemplateBinding ctl:Btn.Icon}" Foreground="{TemplateBinding Foreground}"
                                          Margin="0,0,8,0" />
                            <ContentPresenter x:Name="Content" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ctl:Btn.Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Content" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Icon" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Overlay" Storyboard.TargetProperty="Opacity" To="0.05" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Overlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.1" />
                            <Setter TargetName="Root" Property="RenderTransformOrigin" Value="0.5,0.5" />
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn.Secondary" TargetType="Button" BasedOn="{StaticResource Btn.Base}" />

    <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{StaticResource B.Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Accent}" />
        <Setter Property="Foreground" Value="{StaticResource B.OnAccent}" />
    </Style>

    <Style x:Key="Btn.Danger" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{StaticResource B.ErrorSubtle}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.ErrorBorder}" />
        <Setter Property="Foreground" Value="{StaticResource B.Error}" />
    </Style>

    <Style x:Key="Btn.Ghost" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource B.TextSecondary}" />
    </Style>

    <Style x:Key="Btn.Icon" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="Btn.IconGhost" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="Btn.Link" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
        <Setter Property="Foreground" Value="{StaticResource B.Accent}" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="6,0" />
    </Style>

    <!-- Системные кнопки заголовка окна -->
    <Style x:Key="Btn.Caption" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Foreground" Value="{StaticResource B.TextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Hover" Background="{TemplateBinding Background}" Opacity="0" />
                        <ctl:IconView x:Name="Icon" Data="{TemplateBinding ctl:Btn.Icon}" Width="12" Height="12"
                                      Foreground="{TemplateBinding Foreground}" StrokeThickness="1.75" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════ Чипы (фильтры) ═══════════
         Выбранный чип плавно «раздвигается», показывая галочку. -->
    <Style x:Key="Chip" TargetType="ToggleButton">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource B.TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root">
                        <Border x:Name="Bg" CornerRadius="6" BorderThickness="1" Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Border}" />
                        <Border x:Name="SelBg" CornerRadius="6" BorderThickness="1" Background="{StaticResource B.AccentSubtle}"
                                BorderBrush="{StaticResource B.Accent}" Opacity="0" />
                        <Border x:Name="Overlay" CornerRadius="6" Background="White" Opacity="0" Margin="1" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                            <Border x:Name="CheckHolder" Width="0" ClipToBounds="True">
                                <ctl:IconView x:Name="Check" Data="{StaticResource Icon.Check}" Width="12" Height="12"
                                              Foreground="{StaticResource B.Accent}" HorizontalAlignment="Left" Opacity="0" />
                            </Border>
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelBg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="CheckHolder" Storyboard.TargetProperty="Width" To="18" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.06" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="CheckHolder" Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource B.Accent}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Overlay" Storyboard.TargetProperty="Opacity" To="0.05" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Overlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChipRadio" TargetType="RadioButton" BasedOn="{StaticResource Chip}" />

    <!-- Переключатель вида (список / плитки): квадратная кнопка с подсветкой -->
    <Style x:Key="ViewToggle" TargetType="RadioButton">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border Background="{StaticResource B.Control}" BorderBrush="{StaticResource B.Border}" BorderThickness="1" CornerRadius="6" />
                        <Border x:Name="Sel" Background="{StaticResource B.Pressed}" BorderBrush="{StaticResource B.Border}" BorderThickness="1"
                                CornerRadius="6" Opacity="0" />
                        <ctl:IconView Data="{TemplateBinding ctl:Btn.Icon}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════ Переключатель вкл/выкл ═══════════
         Анимации идут через путь свойства: так WPF сам создаёт изменяемые копии кистей. -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="Root" Background="Transparent">
                        <Border x:Name="Track" CornerRadius="10" BorderThickness="1">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource C.Hover}" />
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource C.Border}" />
                            </Border.BorderBrush>
                        </Border>
                        <Ellipse x:Name="Knob" Width="14" Height="14" HorizontalAlignment="Left" Margin="3,0,0,0">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="{StaticResource C.Text}" />
                            </Ellipse.Fill>
                            <Ellipse.RenderTransform>
                                <TranslateTransform X="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="16" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="{StaticResource C.Accent}" Duration="0:0:0.2" />
                                        <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                        To="{StaticResource C.Accent}" Duration="0:0:0.2" />
                                        <ColorAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"
                                                        To="{StaticResource C.Background}" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="{StaticResource C.Hover}" Duration="0:0:0.2" />
                                        <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                        To="{StaticResource C.Border}" Duration="0:0:0.2" />
                                        <ColorAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"
                                                        To="{StaticResource C.Text}" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Квадратная галочка для выбора нескольких модов -->
    <Style x:Key="SelectBox" TargetType="CheckBox">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Border x:Name="Box" CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource B.Border}" Background="{StaticResource B.Surface}" />
                        <ctl:IconView x:Name="Mark" Data="{StaticResource Icon.Check}" Width="11" Height="11" Foreground="{StaticResource B.Accent}"
                                      StrokeThickness="3" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource B.AccentSubtle}" />
                            <Setter TargetName="Mark" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════ Поле поиска ═══════════ -->
    <Style TargetType="ctl:SearchBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource B.Text}" />
        <Setter Property="SelectionBrush" Value="{StaticResource B.Accent}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctl:SearchBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Border}" BorderThickness="1" CornerRadius="6" />
                        <Border x:Name="FocusBd" BorderBrush="{StaticResource B.Accent}" BorderThickness="1" CornerRadius="6" Opacity="0" />
                        <Grid Margin="12,0,6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ctl:IconView Data="{StaticResource Icon.Search}" Foreground="{StaticResource B.TextSecondary}" Margin="0,0,8,0" />
                            <TextBlock x:Name="Placeholder" Grid.Column="1" Text="{TemplateBinding Placeholder}" Foreground="{StaticResource B.TextMuted}"
                                       VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" />
                            <TextBlock x:Name="Hint" Grid.Column="2" Text="Ctrl + F" FontSize="10" Foreground="{StaticResource B.TextMuted}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button x:Name="PART_Clear" Grid.Column="2" Style="{StaticResource Btn.IconGhost}" Width="22" Height="22"
                                    ctl:Btn.Icon="{StaticResource Icon.X}" Visibility="Collapsed" ToolTip="Очистить (Esc)" IsTabStop="False" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#555555" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusBd" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusBd" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Обычное текстовое поле (переименование и т.п.) -->
    <Style x:Key="Input" TargetType="TextBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource B.Text}" />
        <Setter Property="SelectionBrush" Value="{StaticResource B.Accent}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Border}" BorderThickness="1" CornerRadius="6" Padding="10,0">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════ Метки (бейджи) ═══════════ -->
    <Style x:Key="Tag" TargetType="Border">
        <Setter Property="Height" Value="18" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{StaticResource B.Control}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="TagText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource B.TextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ═══════════ Карточка-панель ═══════════ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource B.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- ═══════════ Полосы прокрутки: тонкие, расширяются при наведении ═══════════ -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" Background="{StaticResource B.Border}" CornerRadius="3" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="#5A5A5A" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="T" Property="Background" Value="#6A6A6A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,4">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" Margin="4,2">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════ Подсказки ═══════════ -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="MaxWidth" Value="320" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource B.Control}" BorderBrush="{StaticResource B.Border}" BorderThickness="1"
                            CornerRadius="6" Padding="10,6">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Пункт выпадающего меню (сортировка, тип) -->
    <Style x:Key="MenuOption" TargetType="RadioButton">
        <Setter Property="Height" Value="30" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="18">
                                <ctl:IconView x:Name="Check" Data="{StaticResource Icon.Check}" Width="12" Height="12" Foreground="{StaticResource B.Accent}"
                                              HorizontalAlignment="Left" Visibility="Hidden" />
                            </Border>
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource B.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Индикатор прогресса -->
    <Style x:Key="Progress" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{StaticResource B.Hover}" CornerRadius="2" />
                        <Border x:Name="PART_Indicator" Background="{StaticResource B.Accent}" CornerRadius="2" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
