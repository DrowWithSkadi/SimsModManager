<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Палитра «Стекло · размытие Windows 11». Все цвета программы берутся отсюда через DynamicResource, поэтому тема меняется на лету.
         Дымчатое тёмное стекло: само окно затемнено (~55%), чтобы текст читался даже на белых обоях,
         а каждый вложенный слой (содержимое → карточки → поля и кнопки) ещё темнее предыдущего. -->
    <SolidColorBrush x:Key="B.Window" Color="#8C141414" />
    <SolidColorBrush x:Key="B.TitleBar" Color="#00000000" />
    <SolidColorBrush x:Key="B.StatusBar" Color="#2E000000" />
    <SolidColorBrush x:Key="B.Background" Color="#2E000000" />
    <SolidColorBrush x:Key="B.Surface" Color="#4D000000" />
    <SolidColorBrush x:Key="B.Popup" Color="#F21A1A1A" />
    <SolidColorBrush x:Key="B.Control" Color="#47000000" />
    <SolidColorBrush x:Key="B.Hover" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="B.Pressed" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="B.Border" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="B.BorderHover" Color="#3DFFFFFF" />
    <SolidColorBrush x:Key="B.Text" Color="#F6F6F4" />
    <SolidColorBrush x:Key="B.TextSecondary" Color="#C4C4C0" />
    <SolidColorBrush x:Key="B.TextMuted" Color="#8F8F8A" />
    <SolidColorBrush x:Key="B.Accent" Color="#82EACF" />
    <SolidColorBrush x:Key="B.AccentSubtle" Color="#2E77E1C7" />
    <SolidColorBrush x:Key="B.OnAccent" Color="#0F2A23" />
    <SolidColorBrush x:Key="B.Error" Color="#F5A3A3" />
    <SolidColorBrush x:Key="B.ErrorSubtle" Color="#33F18B8B" />
    <SolidColorBrush x:Key="B.ErrorBorder" Color="#66F18B8B" />
    <SolidColorBrush x:Key="B.ErrorCard" Color="#24F18B8B" />
    <SolidColorBrush x:Key="B.Warning" Color="#F0CC8A" />
    <SolidColorBrush x:Key="B.WarningSubtle" Color="#2EE7BE78" />
    <SolidColorBrush x:Key="B.WarningBorder" Color="#66E7BE78" />
    <SolidColorBrush x:Key="B.Overlay" Color="#A6000000" />
    <SolidColorBrush x:Key="B.DropOverlay" Color="#D9101010" />
    <SolidColorBrush x:Key="B.DropFill" Color="#1477E1C7" />
    <SolidColorBrush x:Key="B.HoverOverlay" Color="#FFFFFF" />
    <SolidColorBrush x:Key="B.SelectionBar" Color="#66101614" />
    <SolidColorBrush x:Key="B.SuccessTag" Color="#3377E1C7" />
    <SolidColorBrush x:Key="B.Thumb" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="B.ThumbHover" Color="#59FFFFFF" />
    <SolidColorBrush x:Key="B.ThumbDrag" Color="#80FFFFFF" />
</ResourceDictionary>
