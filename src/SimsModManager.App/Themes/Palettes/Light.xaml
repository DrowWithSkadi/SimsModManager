<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Палитра «Светлая»: нейтральный белый, акцент — почти чёрный. Боковая панель остаётся тёмной — отдельная карточка с тенью. Все цвета программы берутся отсюда через DynamicResource, поэтому тема меняется на лету. -->
    <SolidColorBrush x:Key="B.Window" Color="#F4F4F6" />
    <SolidColorBrush x:Key="B.TitleBar" Color="#00000000" />
    <SolidColorBrush x:Key="B.StatusBar" Color="#ECECEF" />
    <SolidColorBrush x:Key="B.Background" Color="#F4F4F6" />
    <SolidColorBrush x:Key="B.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="B.Popup" Color="#FFFFFF" />
    <SolidColorBrush x:Key="B.Control" Color="#EFEFF2" />
    <SolidColorBrush x:Key="B.Hover" Color="#E7E7EB" />
    <SolidColorBrush x:Key="B.Pressed" Color="#DCDCE1" />
    <SolidColorBrush x:Key="B.Border" Color="#E2E2E7" />
    <SolidColorBrush x:Key="B.BorderHover" Color="#CACAD1" />
    <SolidColorBrush x:Key="B.Text" Color="#1B1C20" />
    <SolidColorBrush x:Key="B.TextSecondary" Color="#50525A" />
    <SolidColorBrush x:Key="B.TextMuted" Color="#85878F" />
    <SolidColorBrush x:Key="B.Accent" Color="#1B1C20" />
    <SolidColorBrush x:Key="B.AccentSubtle" Color="#E9E9EC" />
    <SolidColorBrush x:Key="B.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="B.Error" Color="#C0463F" />
    <SolidColorBrush x:Key="B.ErrorSubtle" Color="#FBE7E6" />
    <SolidColorBrush x:Key="B.ErrorBorder" Color="#EDB8B4" />
    <SolidColorBrush x:Key="B.ErrorCard" Color="#FDF2F1" />
    <SolidColorBrush x:Key="B.Warning" Color="#B07A1F" />
    <SolidColorBrush x:Key="B.WarningSubtle" Color="#FBF1DE" />
    <SolidColorBrush x:Key="B.WarningBorder" Color="#E9CF98" />
    <SolidColorBrush x:Key="B.Overlay" Color="#801B1C20" />
    <SolidColorBrush x:Key="B.DropOverlay" Color="#EBF4F4F6" />
    <SolidColorBrush x:Key="B.DropFill" Color="#141B1C20" />
    <SolidColorBrush x:Key="B.HoverOverlay" Color="#000000" />
    <SolidColorBrush x:Key="B.SelectionBar" Color="#E9E9EC" />
    <SolidColorBrush x:Key="B.SuccessTag" Color="#DCF3EC" />
    <SolidColorBrush x:Key="B.Thumb" Color="#CFCFD5" />
    <SolidColorBrush x:Key="B.ThumbHover" Color="#B6B6BE" />
    <SolidColorBrush x:Key="B.ThumbDrag" Color="#9C9DA6" />
    <!-- Боковая панель — тёмная карточка в любой теме; кнопка «Играть» всегда тёмная -->
    <SolidColorBrush x:Key="B.Success" Color="#2B9C82" />
    <SolidColorBrush x:Key="B.Side" Color="#1E1F23" />
    <SolidColorBrush x:Key="B.SideBorder" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="B.SideText" Color="#EEEEF0" />
    <SolidColorBrush x:Key="B.SideMuted" Color="#8A8B93" />
    <SolidColorBrush x:Key="B.SideSelected" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="B.SideAccent" Color="#F2F2F4" />
    <SolidColorBrush x:Key="B.PlayFace" Color="#26272C" />
    <SolidColorBrush x:Key="B.OnPlay" Color="#F2F2F4" />
    <SolidColorBrush x:Key="B.PlayRun" Color="#F21E1F23" />
    <!-- Рамка кнопки «Играть» — градиент цветка сакуры: мятный → голубой → сиреневый → персиковый. Сама кнопка тёмная (B.PlayFace) -->
    <LinearGradientBrush x:Key="B.Play" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#77E1C7" Offset="0" />
        <GradientStop Color="#8CC8FF" Offset="0.35" />
        <GradientStop Color="#B8A4FF" Offset="0.7" />
        <GradientStop Color="#FFC2AE" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
