<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Палитра «Светлая»: прохладный белый, белые карточки. Боковая панель остаётся тёмной — отдельная карточка с тенью. Все цвета программы берутся отсюда через DynamicResource, поэтому тема меняется на лету. -->
    <SolidColorBrush x:Key="B.Window" Color="#F3F4F8" />
    <SolidColorBrush x:Key="B.TitleBar" Color="#00000000" />
    <SolidColorBrush x:Key="B.StatusBar" Color="#EBEDF3" />
    <SolidColorBrush x:Key="B.Background" Color="#F3F4F8" />
    <SolidColorBrush x:Key="B.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="B.Popup" Color="#FFFFFF" />
    <SolidColorBrush x:Key="B.Control" Color="#EEF0F6" />
    <SolidColorBrush x:Key="B.Hover" Color="#E6E9F2" />
    <SolidColorBrush x:Key="B.Pressed" Color="#DADEEA" />
    <SolidColorBrush x:Key="B.Border" Color="#E1E4EE" />
    <SolidColorBrush x:Key="B.BorderHover" Color="#C9CEDD" />
    <SolidColorBrush x:Key="B.Text" Color="#1B1D26" />
    <SolidColorBrush x:Key="B.TextSecondary" Color="#4E5366" />
    <SolidColorBrush x:Key="B.TextMuted" Color="#848A9E" />
    <SolidColorBrush x:Key="B.Accent" Color="#6C5CE7" />
    <SolidColorBrush x:Key="B.AccentSubtle" Color="#ECE9FF" />
    <SolidColorBrush x:Key="B.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="B.Error" Color="#C0463F" />
    <SolidColorBrush x:Key="B.ErrorSubtle" Color="#FBE7E6" />
    <SolidColorBrush x:Key="B.ErrorBorder" Color="#EDB8B4" />
    <SolidColorBrush x:Key="B.ErrorCard" Color="#FDF2F1" />
    <SolidColorBrush x:Key="B.Warning" Color="#B07A1F" />
    <SolidColorBrush x:Key="B.WarningSubtle" Color="#FBF1DE" />
    <SolidColorBrush x:Key="B.WarningBorder" Color="#E9CF98" />
    <SolidColorBrush x:Key="B.Overlay" Color="#801B1D26" />
    <SolidColorBrush x:Key="B.DropOverlay" Color="#EBF3F4F8" />
    <SolidColorBrush x:Key="B.DropFill" Color="#146C5CE7" />
    <SolidColorBrush x:Key="B.HoverOverlay" Color="#000000" />
    <SolidColorBrush x:Key="B.SelectionBar" Color="#E7E3FF" />
    <SolidColorBrush x:Key="B.SuccessTag" Color="#DCF3EC" />
    <SolidColorBrush x:Key="B.Thumb" Color="#CDD2DF" />
    <SolidColorBrush x:Key="B.ThumbHover" Color="#B3B9CA" />
    <SolidColorBrush x:Key="B.ThumbDrag" Color="#9AA1B5" />
    <!-- Боковая панель — тёмная карточка в любой теме; Success — «включено, всё хорошо» -->
    <SolidColorBrush x:Key="B.Success" Color="#2B9C82" />
    <SolidColorBrush x:Key="B.Side" Color="#181B27" />
    <SolidColorBrush x:Key="B.SideBorder" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="B.SideText" Color="#EEF0F7" />
    <SolidColorBrush x:Key="B.SideMuted" Color="#8C91A8" />
    <SolidColorBrush x:Key="B.SideSelected" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="B.SideAccent" Color="#B9AEFF" />
    <SolidColorBrush x:Key="B.OnPlay" Color="#17142B" />
    <SolidColorBrush x:Key="B.PlayRun" Color="#F2181B27" />
    <!-- Кнопка «Играть» — градиент цветка сакуры: мятный → голубой → сиреневый → персиковый -->
    <LinearGradientBrush x:Key="B.Play" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#77E1C7" Offset="0" />
        <GradientStop Color="#8CC8FF" Offset="0.35" />
        <GradientStop Color="#B8A4FF" Offset="0.7" />
        <GradientStop Color="#FFC2AE" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
