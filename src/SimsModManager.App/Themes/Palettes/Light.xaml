<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Палитра «Светлая · слоновая кость». Все цвета программы берутся отсюда через DynamicResource, поэтому тема меняется на лету. -->
    <SolidColorBrush x:Key="B.Window" Color="#F4F1EA" />
    <SolidColorBrush x:Key="B.TitleBar" Color="#00000000" /> <!-- заголовок окна — того же цвета, что окно -->
    <SolidColorBrush x:Key="B.StatusBar" Color="#ECE8DF" />
    <SolidColorBrush x:Key="B.Background" Color="#F4F1EA" />
    <SolidColorBrush x:Key="B.Surface" Color="#FBFAF6" />
    <SolidColorBrush x:Key="B.Popup" Color="#FDFCF9" />
    <SolidColorBrush x:Key="B.Control" Color="#F1EDE4" />
    <SolidColorBrush x:Key="B.Hover" Color="#E9E4D9" />
    <SolidColorBrush x:Key="B.Pressed" Color="#DFD9CC" />
    <SolidColorBrush x:Key="B.Border" Color="#DCD5C7" />
    <SolidColorBrush x:Key="B.BorderHover" Color="#C6BEAE" />
    <SolidColorBrush x:Key="B.Text" Color="#25231F" />
    <SolidColorBrush x:Key="B.TextSecondary" Color="#5F5B53" />
    <SolidColorBrush x:Key="B.TextMuted" Color="#8E897F" />
    <SolidColorBrush x:Key="B.Accent" Color="#2B9C82" />
    <SolidColorBrush x:Key="B.AccentSubtle" Color="#DCF0E9" />
    <SolidColorBrush x:Key="B.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="B.Error" Color="#C0463F" />
    <SolidColorBrush x:Key="B.ErrorSubtle" Color="#F8E5E2" />
    <SolidColorBrush x:Key="B.ErrorBorder" Color="#E5B3AE" />
    <SolidColorBrush x:Key="B.ErrorCard" Color="#FBEEEC" />
    <SolidColorBrush x:Key="B.Warning" Color="#9C6510" />
    <SolidColorBrush x:Key="B.WarningSubtle" Color="#F7EDD7" />
    <SolidColorBrush x:Key="B.WarningBorder" Color="#E2C995" />
    <SolidColorBrush x:Key="B.Overlay" Color="#802B2722" />
    <SolidColorBrush x:Key="B.DropOverlay" Color="#EBF4F1EA" />
    <SolidColorBrush x:Key="B.DropFill" Color="#142B9C82" />
    <SolidColorBrush x:Key="B.HoverOverlay" Color="#000000" />
    <SolidColorBrush x:Key="B.SelectionBar" Color="#E2F2EC" />
    <SolidColorBrush x:Key="B.SuccessTag" Color="#DCF0E9" />
    <SolidColorBrush x:Key="B.Thumb" Color="#CFC8B9" />
    <SolidColorBrush x:Key="B.ThumbHover" Color="#B9B1A0" />
    <SolidColorBrush x:Key="B.ThumbDrag" Color="#A59C8A" />
</ResourceDictionary>
