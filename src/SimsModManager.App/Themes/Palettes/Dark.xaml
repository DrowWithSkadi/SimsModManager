<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Палитра «Тёмная · графит (UI-kit)». Все цвета программы берутся отсюда через DynamicResource, поэтому тема меняется на лету. -->
    <SolidColorBrush x:Key="B.Window" Color="#191919" />
    <SolidColorBrush x:Key="B.TitleBar" Color="#00000000" /> <!-- заголовок окна — того же цвета, что окно -->
    <SolidColorBrush x:Key="B.StatusBar" Color="#222222" />
    <SolidColorBrush x:Key="B.Background" Color="#191919" />
    <SolidColorBrush x:Key="B.Surface" Color="#222222" />
    <SolidColorBrush x:Key="B.Popup" Color="#262626" />
    <SolidColorBrush x:Key="B.Control" Color="#2B2B2B" />
    <SolidColorBrush x:Key="B.Hover" Color="#333333" />
    <SolidColorBrush x:Key="B.Pressed" Color="#3E3E3E" />
    <SolidColorBrush x:Key="B.Border" Color="#414141" />
    <SolidColorBrush x:Key="B.BorderHover" Color="#555555" />
    <SolidColorBrush x:Key="B.Text" Color="#F3F3F1" />
    <SolidColorBrush x:Key="B.TextSecondary" Color="#B8B8B4" />
    <SolidColorBrush x:Key="B.TextMuted" Color="#858582" />
    <SolidColorBrush x:Key="B.Accent" Color="#77E1C7" />
    <SolidColorBrush x:Key="B.AccentSubtle" Color="#243C35" />
    <SolidColorBrush x:Key="B.OnAccent" Color="#0F2A23" />
    <SolidColorBrush x:Key="B.Error" Color="#F18B8B" />
    <SolidColorBrush x:Key="B.ErrorSubtle" Color="#3A2627" />
    <SolidColorBrush x:Key="B.ErrorBorder" Color="#6E3B3C" />
    <SolidColorBrush x:Key="B.ErrorCard" Color="#2A2223" />
    <SolidColorBrush x:Key="B.Warning" Color="#E7BE78" />
    <SolidColorBrush x:Key="B.WarningSubtle" Color="#3A3224" />
    <SolidColorBrush x:Key="B.WarningBorder" Color="#6A5733" />
    <SolidColorBrush x:Key="B.Overlay" Color="#D9101010" />
    <SolidColorBrush x:Key="B.DropOverlay" Color="#E6141414" />
    <SolidColorBrush x:Key="B.DropFill" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="B.HoverOverlay" Color="#FFFFFF" />
    <SolidColorBrush x:Key="B.SelectionBar" Color="#1E2B27" />
    <SolidColorBrush x:Key="B.SuccessTag" Color="#1F3A2F" />
    <SolidColorBrush x:Key="B.Thumb" Color="#414141" />
    <SolidColorBrush x:Key="B.ThumbHover" Color="#5A5A5A" />
    <SolidColorBrush x:Key="B.ThumbDrag" Color="#6A6A6A" />
</ResourceDictionary>
