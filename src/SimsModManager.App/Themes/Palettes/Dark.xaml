<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Палитра «Тёмная»: холодный сине-чёрный, как ночь на сайте. Акцент — сиреневый из сердцевины сакуры, мятный — цвет «всё хорошо». Все цвета программы берутся отсюда через DynamicResource, поэтому тема меняется на лету. -->
    <SolidColorBrush x:Key="B.Window" Color="#0E1016" />
    <SolidColorBrush x:Key="B.TitleBar" Color="#00000000" />
    <SolidColorBrush x:Key="B.StatusBar" Color="#13151D" />
    <SolidColorBrush x:Key="B.Background" Color="#0E1016" />
    <SolidColorBrush x:Key="B.Surface" Color="#161922" />
    <SolidColorBrush x:Key="B.Popup" Color="#1A1D28" />
    <SolidColorBrush x:Key="B.Control" Color="#1D2130" />
    <SolidColorBrush x:Key="B.Hover" Color="#252A3A" />
    <SolidColorBrush x:Key="B.Pressed" Color="#2E3446" />
    <SolidColorBrush x:Key="B.Border" Color="#2A2F40" />
    <SolidColorBrush x:Key="B.BorderHover" Color="#3A4056" />
    <SolidColorBrush x:Key="B.Text" Color="#EEF0F7" />
    <SolidColorBrush x:Key="B.TextSecondary" Color="#B4B8CC" />
    <SolidColorBrush x:Key="B.TextMuted" Color="#7D8299" />
    <SolidColorBrush x:Key="B.Accent" Color="#A99CFF" />
    <SolidColorBrush x:Key="B.AccentSubtle" Color="#262241" />
    <SolidColorBrush x:Key="B.OnAccent" Color="#15112B" />
    <SolidColorBrush x:Key="B.Error" Color="#F18B8B" />
    <SolidColorBrush x:Key="B.ErrorSubtle" Color="#3A2328" />
    <SolidColorBrush x:Key="B.ErrorBorder" Color="#6E3B44" />
    <SolidColorBrush x:Key="B.ErrorCard" Color="#261B22" />
    <SolidColorBrush x:Key="B.Warning" Color="#E7BE78" />
    <SolidColorBrush x:Key="B.WarningSubtle" Color="#352E22" />
    <SolidColorBrush x:Key="B.WarningBorder" Color="#6A5733" />
    <SolidColorBrush x:Key="B.Overlay" Color="#D90A0C12" />
    <SolidColorBrush x:Key="B.DropOverlay" Color="#E60C0E14" />
    <SolidColorBrush x:Key="B.DropFill" Color="#14A99CFF" />
    <SolidColorBrush x:Key="B.HoverOverlay" Color="#FFFFFF" />
    <SolidColorBrush x:Key="B.SelectionBar" Color="#1E1B33" />
    <SolidColorBrush x:Key="B.SuccessTag" Color="#1C3A33" />
    <SolidColorBrush x:Key="B.Thumb" Color="#2E3446" />
    <SolidColorBrush x:Key="B.ThumbHover" Color="#40475E" />
    <SolidColorBrush x:Key="B.ThumbDrag" Color="#525A74" />
    <!-- Боковая панель — тёмная карточка в любой теме; Success — «включено, всё хорошо» -->
    <SolidColorBrush x:Key="B.Success" Color="#77E1C7" />
    <SolidColorBrush x:Key="B.Side" Color="#1B1E2B" />
    <SolidColorBrush x:Key="B.SideBorder" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="B.SideText" Color="#EEF0F7" />
    <SolidColorBrush x:Key="B.SideMuted" Color="#8C91A8" />
    <SolidColorBrush x:Key="B.SideSelected" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="B.SideAccent" Color="#B9AEFF" />
    <SolidColorBrush x:Key="B.OnPlay" Color="#17142B" />
    <SolidColorBrush x:Key="B.PlayRun" Color="#E61B1E2B" />
    <!-- Кнопка «Играть» — градиент цветка сакуры: мятный → голубой → сиреневый → персиковый -->
    <LinearGradientBrush x:Key="B.Play" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#77E1C7" Offset="0" />
        <GradientStop Color="#8CC8FF" Offset="0.35" />
        <GradientStop Color="#B8A4FF" Offset="0.7" />
        <GradientStop Color="#FFC2AE" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
