<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Палитра «Тёмная»: нейтральный графит — без синевы и без тёплого оттенка. Акцент почти белый, цвет даёт только сакура; мятный — «включено, всё хорошо». Все цвета программы берутся отсюда через DynamicResource, поэтому тема меняется на лету. -->
    <SolidColorBrush x:Key="B.Window" Color="#0F1012" />
    <SolidColorBrush x:Key="B.TitleBar" Color="#00000000" />
    <SolidColorBrush x:Key="B.StatusBar" Color="#141518" />
    <SolidColorBrush x:Key="B.Background" Color="#0F1012" />
    <SolidColorBrush x:Key="B.Surface" Color="#17181B" />
    <SolidColorBrush x:Key="B.Popup" Color="#1C1D21" />
    <SolidColorBrush x:Key="B.Control" Color="#1E1F23" />
    <SolidColorBrush x:Key="B.Hover" Color="#26272C" />
    <SolidColorBrush x:Key="B.Pressed" Color="#303137" />
    <SolidColorBrush x:Key="B.Border" Color="#2A2B30" />
    <SolidColorBrush x:Key="B.BorderHover" Color="#3A3B42" />
    <SolidColorBrush x:Key="B.Text" Color="#EEEEF0" />
    <SolidColorBrush x:Key="B.TextSecondary" Color="#B3B4BA" />
    <SolidColorBrush x:Key="B.TextMuted" Color="#7E8088" />
    <SolidColorBrush x:Key="B.Accent" Color="#E6E6EA" />
    <SolidColorBrush x:Key="B.AccentSubtle" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="B.OnAccent" Color="#17181B" />
    <SolidColorBrush x:Key="B.Error" Color="#F18B8B" />
    <SolidColorBrush x:Key="B.ErrorSubtle" Color="#38232426" />
    <SolidColorBrush x:Key="B.ErrorBorder" Color="#6E3B3D" />
    <SolidColorBrush x:Key="B.ErrorCard" Color="#241B1C" />
    <SolidColorBrush x:Key="B.Warning" Color="#E7BE78" />
    <SolidColorBrush x:Key="B.WarningSubtle" Color="#332D22" />
    <SolidColorBrush x:Key="B.WarningBorder" Color="#6A5733" />
    <SolidColorBrush x:Key="B.Overlay" Color="#D90B0B0D" />
    <SolidColorBrush x:Key="B.DropOverlay" Color="#E60D0E10" />
    <SolidColorBrush x:Key="B.DropFill" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="B.HoverOverlay" Color="#FFFFFF" />
    <SolidColorBrush x:Key="B.SelectionBar" Color="#232428" />
    <SolidColorBrush x:Key="B.SuccessTag" Color="#1A3530" />
    <SolidColorBrush x:Key="B.Thumb" Color="#2E2F35" />
    <SolidColorBrush x:Key="B.ThumbHover" Color="#414249" />
    <SolidColorBrush x:Key="B.ThumbDrag" Color="#53545C" />
    <!-- Боковая панель — тёмная карточка в любой теме; кнопка «Играть» — молочная на ней -->
    <SolidColorBrush x:Key="B.Success" Color="#5FBFA6" />
    <SolidColorBrush x:Key="B.Side" Color="#1C1D21" />
    <SolidColorBrush x:Key="B.SideBorder" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="B.SideText" Color="#EEEEF0" />
    <SolidColorBrush x:Key="B.SideMuted" Color="#8A8B93" />
    <SolidColorBrush x:Key="B.SideSelected" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="B.SideAccent" Color="#F2F2F4" />
    <SolidColorBrush x:Key="B.PlayFace" Color="#ECECF0" />
    <SolidColorBrush x:Key="B.OnPlay" Color="#17181B" />
    <SolidColorBrush x:Key="B.PlayRun" Color="#F2202126" />
    <!-- Цветная тень под кнопкой «Играть» — градиент цветка сакуры: мятный → голубой → сиреневый → персиковый -->
    <LinearGradientBrush x:Key="B.Play" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#77E1C7" Offset="0" />
        <GradientStop Color="#8CC8FF" Offset="0.35" />
        <GradientStop Color="#B8A4FF" Offset="0.7" />
        <GradientStop Color="#FFC2AE" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
