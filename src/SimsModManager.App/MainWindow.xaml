<Window x:Class="SimsModManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:l="clr-namespace:SimsModManager.App.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SimsModManager.App.ViewModels"
        xmlns:views="clr-namespace:SimsModManager.App.Views"
        xmlns:ctl="clr-namespace:SimsModManager.App.Controls"
        xmlns:b="clr-namespace:SimsModManager.App.Behaviors"
        Title="Ancora"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1100" Height="720" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource B.Window}"
        Foreground="{DynamicResource B.Text}"
        FontFamily="{StaticResource Font.Ui}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        AllowDrop="True"
        DragEnter="OnDragEnter" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">

    <!-- Своя рамка окна (тёмный заголовок как в макете) — WindowChrome задаёт ThemeService -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="28" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Border x:Name="RootBorder">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ═══ Заголовок окна ═══ -->
            <Grid Grid.ColumnSpan="2" Background="{DynamicResource B.TitleBar}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Source="pack://application:,,,/Assets/logo-mark.png" Width="14" Height="14" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Ancora" FontSize="11" Foreground="{DynamicResource B.TextMuted}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Btn.Caption}" Background="{DynamicResource B.Hover}" ctl:Btn.Icon="{StaticResource Icon.Minus}"
                            Click="OnMinimize" ToolTip="{l:Tr 'Свернуть'}" />
                    <Button x:Name="MaxButton" Style="{StaticResource Btn.Caption}" Background="{DynamicResource B.Hover}"
                            ctl:Btn.Icon="{StaticResource Icon.Square}" Click="OnMaximize" ToolTip="{l:Tr 'Развернуть'}" />
                    <Button Style="{StaticResource Btn.Caption}" Background="#C42B1C" ctl:Btn.Icon="{StaticResource Icon.X}"
                            Click="OnClose" ToolTip="{l:Tr 'Закрыть'}" />
                </StackPanel>
            </Grid>

            <!-- ═══ Шапка приложения ═══ -->
            <Border Grid.Row="1" Grid.Column="1" Height="72" BorderBrush="{DynamicResource B.Hover}" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid>
                    <StackPanel x:Name="HeaderTexts" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,16,0">
                        <TextBlock Text="Ancora" Style="{StaticResource T.Title}" />
                        <TextBlock Text="{Binding SimsFolderShown}" FontSize="11" Foreground="{DynamicResource B.TextMuted}" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis" Visibility="{Binding HasGame, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <Border Style="{StaticResource Tag}" Background="{DynamicResource B.AccentSubtle}" HorizontalAlignment="Right"
                            Visibility="{Binding HasGame, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Style="{StaticResource TagText}" Text="{l:Tr 'Первый запуск'}" Foreground="{DynamicResource B.Accent}" />
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ Страницы ═══ -->
            <Grid Grid.Row="2" Grid.Column="1">
                <views:LibraryPage x:Name="Library" b:Anim.Show="{Binding ShowLibraryChrome}" b:Anim.Offset="0" />
                <views:SettingsPage b:Anim.Show="{Binding IsSettingsPage}" />
                <views:NotFoundPage b:Anim.Show="{Binding IsNotFoundPage}" />
                <views:CardPage b:Anim.Show="{Binding IsCardPage}" DataContext="{Binding}" />
                <views:EditorPage b:Anim.Show="{Binding IsEditorPage}" />
                <views:HealthPage b:Anim.Show="{Binding IsHealthPage}" />
                <views:PacksPage b:Anim.Show="{Binding IsPacksPage}" />


                <!-- Панель выбора нескольких модов -->
                <Border VerticalAlignment="Bottom" Background="{DynamicResource B.SelectionBar}" BorderBrush="{DynamicResource B.Accent}" BorderThickness="0,1,0,0"
                        Padding="24,10" b:Anim.Show="{Binding IsMultiSelect}" b:Anim.Offset="16">
                    <Grid>
                        <TextBlock Text="{Binding SelectionText}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource B.Accent}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource Btn.Secondary}" ctl:Btn.Icon="{StaticResource Icon.Shirt}" Content="{l:Tr 'Настроить одежду'}"
                                    Command="{Binding EditSelectedCommand}" Margin="0,0,8,0"
                                    ToolTip="{l:Tr 'Пол, возраст и категории сразу для всей одежды из выбранных модов'}" />
                            <Button Style="{StaticResource Btn.Primary}" Content="{l:Tr 'Включить'}" Command="{Binding EnableSelectedCommand}" />
                            <Button Style="{StaticResource Btn.Secondary}" Content="{l:Tr 'Выключить'}" Margin="8,0,0,0" Command="{Binding DisableSelectedCommand}" />
                            <Button Style="{StaticResource Btn.Danger}" ctl:Btn.Icon="{StaticResource Icon.Trash2}" Content="{l:Tr 'Удалить'}" Margin="8,0,0,0"
                                    Command="{Binding DeleteSelectedCommand}" />
                            <Button Style="{StaticResource Btn.Secondary}" Content="{l:Tr 'Снять выделение'}" Margin="8,0,0,0" Command="{Binding ClearSelectionCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Уведомления -->
                <ItemsControl ItemsSource="{Binding Toasts}" ItemTemplate="{StaticResource ToastItem}" VerticalAlignment="Bottom"
                              HorizontalAlignment="Center" Focusable="False">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Margin" Value="0,0,0,16" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMultiSelect}" Value="True">
                                    <Setter Property="Margin" Value="0,0,0,72" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
            </Grid>

            <!-- ═══ Строка состояния ═══
                 Скруглённая полоска по ширине блоков страницы (отступы 24 по бокам), низ — на одной линии с боковой панелью -->
            <Border Grid.Row="3" Grid.Column="1" Height="28" Margin="24,0,24,12" CornerRadius="10" Background="{DynamicResource B.StatusBar}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Ellipse Width="5" Height="5" Fill="{DynamicResource B.Accent}" Margin="0,0,8,0" />
                    <TextBlock FontSize="10" Foreground="{DynamicResource B.TextSecondary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding LastActionText}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditorPage}" Value="True">
                                        <Setter Property="Text" Value="{Binding Editor.ChangeSummary}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCardPage}" Value="True">
                                        <Setter Property="Text" Value="{l:Tr 'Изменения применяются к файлам в папке Mods'}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <TextBlock Text="{Binding SummaryText}" FontSize="11" Foreground="{DynamicResource B.TextSecondary}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Margin="0,0,14,0" Visibility="{Binding HasGame, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{l:Tr 'Данные остаются на вашем компьютере'}" FontSize="11" Foreground="{DynamicResource B.TextSecondary}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Margin="0,0,14,0" Visibility="{Binding HasGame, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
            </Border>

            <!-- ═══ Боковая панель: отдельная капсула с отступами от краёв; раскрываясь, сдвигает страницу ═══ -->
            <ctl:SideBar Grid.Row="1" Grid.RowSpan="3" Margin="12,4,0,12" HorizontalAlignment="Left" />

            <!-- ═══ Перетаскивание файлов ═══ -->
            <Grid Grid.Row="1" Grid.RowSpan="3" Grid.ColumnSpan="2" Background="{DynamicResource B.DropOverlay}" IsHitTestVisible="False"
                  b:Anim.Show="{Binding IsDragOver}" b:Anim.Offset="0">
                <!-- Рамка: бегущий пунктир + «дышащая» подсветка поверх -->
                <Rectangle Margin="32" RadiusX="12" RadiusY="12" Stroke="{DynamicResource B.Accent}" StrokeThickness="1.5" StrokeDashArray="6 4"
                           Fill="{DynamicResource B.DropFill}" b:Anim.March="{Binding IsDragOver}" />
                <Rectangle Margin="32" RadiusX="12" RadiusY="12" Stroke="{DynamicResource B.Accent}" StrokeThickness="3"
                           Fill="Transparent" Opacity="0"
                           b:Anim.GlowScale="1.008" b:Anim.Glow="{Binding IsDragOver}" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Круги расходятся от иконки, сама иконка покачивается -->
                    <Grid Width="96" Height="96" HorizontalAlignment="Center">
                        <Ellipse Stroke="{DynamicResource B.Accent}" StrokeThickness="2" Opacity="0" b:Anim.Ripple="{Binding IsDragOver}" />
                        <Ellipse Stroke="{DynamicResource B.Accent}" StrokeThickness="2" Opacity="0"
                                 b:Anim.RippleDelay="900" b:Anim.Ripple="{Binding IsDragOver}" />
                        <Ellipse Width="64" Height="64" Fill="{DynamicResource B.AccentSubtle}" />
                        <ctl:IconView Data="{StaticResource Icon.Download}" Foreground="{DynamicResource B.Accent}" Width="32" Height="32"
                                      b:Anim.Bob="{Binding IsDragOver}" />
                    </Grid>
                    <TextBlock Text="{l:Tr 'Отпустите, чтобы установить'}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}"
                               HorizontalAlignment="Center" Margin="0,10,0,12" />
                    <Border Style="{StaticResource Tag}" Background="{DynamicResource B.AccentSubtle}" HorizontalAlignment="Center" Height="22" Padding="10,0">
                        <TextBlock Style="{StaticResource TagText}" Text="{Binding DragCountText}" Foreground="{DynamicResource B.Accent}" FontSize="11" />
                    </Border>
                    <TextBlock Text="{l:Tr 'Моды — в Mods, дома и персонажи — в Tray'}" Style="{StaticResource T.Secondary}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </Grid>

            <!-- ═══ Идёт установка ═══ -->
            <Grid Grid.Row="1" Grid.RowSpan="3" Grid.ColumnSpan="2" Background="{DynamicResource B.Overlay}" b:Anim.Show="{Binding IsInstalling}" b:Anim.Offset="0">
                <Border Style="{StaticResource Card}" Background="{DynamicResource B.Popup}" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24,22"
                        b:Anim.Show="{Binding IsInstalling}" b:Anim.Scale="0.96">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.5" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ctl:IconView Data="{StaticResource Icon.PackageOpen}" Foreground="{DynamicResource B.Accent}" Width="22" Height="22" />
                            <TextBlock Text="{l:Tr 'Устанавливаю моды…'}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}" Margin="12,0,0,0" />
                        </StackPanel>
                        <Grid Margin="0,20,0,8">
                            <TextBlock Text="{Binding InstallCountText}" Style="{StaticResource T.Secondary}" />
                            <TextBlock Text="{Binding InstallPercentText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource B.Accent}" HorizontalAlignment="Right" />
                        </Grid>
                        <ProgressBar Style="{StaticResource Progress}" Maximum="100" b:Anim.SmoothValue="{Binding InstallPercent}" />
                        <TextBlock Text="{Binding InstallCurrent}" Style="{StaticResource T.Secondary}" FontSize="11" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{l:Tr 'Распаковываем архивы и раскладываем файлы по папкам. Это займёт несколько секунд.'}" Style="{StaticResource T.Muted}"
                                   TextWrapping="Wrap" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ Коробок: живёт поверх шапки, страниц и строки состояния ═══ -->
            <ctl:MascotStage Grid.Row="1" Grid.RowSpan="3" Grid.Column="1" Page="{Binding Page}" Notice="{Binding MascotNotice}"
                             Visibility="{Binding ShowMascot, Converter={StaticResource BoolToVisibility}}" />

            <!-- ═══ Диалог ═══ -->
            <Grid Grid.Row="0" Grid.RowSpan="4" Grid.ColumnSpan="2" Background="{DynamicResource B.Overlay}" b:Anim.Show="{Binding HasDialog}" b:Anim.Offset="0"
                  MouseLeftButtonDown="OnOverlayClick">
                <Border Style="{StaticResource Card}" Background="{DynamicResource B.Popup}" Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20"
                        DataContext="{Binding DisplayedDialog}" b:Anim.Show="{Binding DataContext.HasDialog, RelativeSource={RelativeSource AncestorType=Window}}"
                        b:Anim.Scale="0.96" MouseLeftButtonDown="OnDialogClick">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.5" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ctl:IconView x:Name="DialogIcon" Data="{Binding Icon}" Width="18" Height="18" VerticalAlignment="Top" Margin="0,3,12,0">
                                <ctl:IconView.Style>
                                    <Style TargetType="ctl:IconView" BasedOn="{StaticResource {x:Type ctl:IconView}}">
                                        <Setter Property="Foreground" Value="{DynamicResource B.Accent}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IconIsDanger}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource B.Error}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ctl:IconView.Style>
                            </ctl:IconView>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}" TextWrapping="Wrap" />
                            <Button Grid.Column="2" Style="{StaticResource Btn.IconGhost}" ctl:Btn.Icon="{StaticResource Icon.X}" Command="{Binding CancelCommand}"
                                    Margin="8,-4,-6,0" VerticalAlignment="Top" ToolTip="{l:Tr 'Закрыть (Esc)'}" />
                        </Grid>
                        <TextBlock Text="{Binding Message}" Style="{StaticResource T.Secondary}" TextWrapping="Wrap" LineHeight="18" Margin="0,14,0,0"
                                   Visibility="{Binding Message, Converter={StaticResource NullToVisibility}}" />

                        <Border Background="{DynamicResource B.Background}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1" CornerRadius="6"
                                Padding="12,10" Margin="0,14,0,0" Visibility="{Binding HasInfo, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{Binding InfoTitle}" Style="{StaticResource T.Strong}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding InfoSubtitle}" Style="{StaticResource T.Muted}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource B.Background}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1" CornerRadius="6"
                                Height="32" Padding="10,0" Margin="0,14,0,0" Visibility="{Binding HasPath, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding PathText}" FontSize="11" Foreground="{DynamicResource B.TextSecondary}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>

                        <Border Background="{DynamicResource B.Background}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1" CornerRadius="6"
                                Padding="12,10" Margin="0,14,0,0" MaxHeight="160" Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                         Foreground="{DynamicResource B.TextMuted}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>

                        <StackPanel Margin="0,14,0,0" Visibility="{Binding HasInput, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding InputLabel}" Style="{StaticResource T.Muted}" Margin="0,0,0,6" />
                            <TextBox x:Name="DialogInput" Style="{StaticResource Input}" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                     IsVisibleChanged="OnDialogInputVisible" />
                            <TextBlock Text="{Binding InputHint}" Style="{StaticResource T.Muted}" FontSize="10" Margin="0,6,0,0" />
                        </StackPanel>

                        <TextBlock Text="{Binding Message2}" Style="{StaticResource T.Secondary}" TextWrapping="Wrap" LineHeight="18" Margin="0,14,0,0"
                                   Visibility="{Binding HasMessage2, Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <TextBlock Text="{l:Tr 'Скопировано'}" Style="{StaticResource T.Muted}" Foreground="{DynamicResource B.Accent}" VerticalAlignment="Center"
                                       Margin="0,0,12,0" Visibility="{Binding Copied, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource Btn.Secondary}" Content="{Binding ExtraText}" Command="{Binding ExtraCommand}" Margin="0,0,8,0"
                                    Visibility="{Binding HasExtra, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource Btn.Secondary}" Content="{Binding SecondaryText}" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                                    Visibility="{Binding HasSecondary, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PrimaryIsDanger}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource B.ErrorSubtle}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource B.ErrorBorder}" />
                                                <Setter Property="Foreground" Value="{DynamicResource B.Error}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
