<Window x:Class="SimsModManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SimsModManager.App.ViewModels"
        Title="Sims Mod Manager"
        Width="1100" Height="720" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        AllowDrop="True"
        DragEnter="OnDragEnter" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid Margin="20,16,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Sims Mod Manager" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0"
                               Text="{Binding SimsFolder, TargetNullValue='Папка игры не найдена'}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource BaseButton}" Command="{Binding OpenModsFolderCommand}"
                            IsEnabled="{Binding HasGame}" Margin="0,0,8,0" ToolTip="Открыть папку Mods в проводнике">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" Margin="0,0,8,0" />
                            <TextBlock Text="Папка Mods" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BaseButton}" Command="{Binding ClearCacheCommand}"
                            IsEnabled="{Binding HasGame}" Margin="0,0,8,0"
                            ToolTip="Удаляет localthumbcache.package. Помогает, если в игре видны старые или сломанные вещи после установки модов.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Margin="0,0,8,0" />
                            <TextBlock Text="Очистить кэш" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BaseButton}" Command="{Binding ChooseFolderCommand}" ToolTip="Указать папку игры вручную">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Margin="0,0,8,0" />
                            <TextBlock Text="Папка игры" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Предупреждение о настройках игры -->
            <Border Grid.Row="1" Background="{StaticResource WarningBgBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,14"
                    Visibility="{Binding OptionsWarning, Converter={StaticResource NullToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource WarningBrush}" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding OptionsWarning}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="2" Style="{StaticResource BaseButton}" Content="Включить моды" Command="{Binding FixOptionsCommand}" />
                </Grid>
            </Border>

            <!-- Игра не найдена -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                    Visibility="{Binding HasGame, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="36" HorizontalAlignment="Center"
                               Foreground="{StaticResource WarningBrush}" />
                    <TextBlock Text="Не нашёл папку The Sims 4" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,12,0,6" />
                    <TextBlock Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                               Text="Обычно она лежит в «Документы\Electronic Arts\The Sims 4». Если игра ни разу не запускалась, запустите её один раз, или укажите папку вручную." />
                    <Button Style="{StaticResource PrimaryButton}" Content="Указать папку" Margin="0,16,0,0"
                            HorizontalAlignment="Center" Command="{Binding ChooseFolderCommand}" />
                </StackPanel>
            </Border>

            <!-- Основная часть -->
            <Grid Grid.Row="2" Visibility="{Binding HasGame, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <!-- Список модов -->
                <Grid Grid.Column="0" Margin="0,0,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource SearchBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="3" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentButton}" Content="Все" GroupName="Filter"
                                             IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=All}" />
                                <RadioButton Style="{StaticResource SegmentButton}" Content="Включённые" GroupName="Filter"
                                             IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=Enabled}" />
                                <RadioButton Style="{StaticResource SegmentButton}" Content="Выключенные" GroupName="Filter"
                                             IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=Disabled}" />
                            </StackPanel>
                        </Border>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="6,0,0,0"
                                Command="{Binding RefreshCommand}" ToolTip="Обновить список" />
                    </Grid>

                    <ListBox Grid.Row="1" ItemsSource="{Binding ModsView}"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource ModListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ModItemViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Здесь позже будет картинка из мода -->
                                    <Border Width="44" Height="44" CornerRadius="8" Background="{StaticResource Surface2Brush}" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Initial}" FontSize="18" FontWeight="SemiBold"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <Border Background="{StaticResource Surface2Brush}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                    Visibility="{Binding HasScripts, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="скрипт" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                            </Border>
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource WarningBrush}"
                                                       Margin="8,0,0,0" ToolTip="{Binding ProblemsText}"
                                                       Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,0">
                                            <Run Text="{Binding DetailsText, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding DateText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Показать в проводнике"
                                                Command="{Binding DataContext.OpenModLocationCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource DangerIconButton}" Content="&#xE74D;" ToolTip="Удалить мод"
                                                Command="{Binding DataContext.DeleteModCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>

                                    <CheckBox Grid.Column="3" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              IsChecked="{Binding IsEnabled}" ToolTip="Включить / выключить мод" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Пустой список -->
                    <TextBlock Grid.Row="1" Style="{StaticResource MutedText}" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                               Text="Модов пока нет. Перетащите архивы с модами в это окно."
                               Visibility="{Binding HasNoMods, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <!-- Правая панель: установка -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="2" CornerRadius="12"
                            Background="{StaticResource SurfaceBrush}" Padding="20,26">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="30"
                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Перетащите архивы сюда" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,10,0,4" />
                            <TextBlock Style="{StaticResource MutedText}" TextAlignment="Center" TextWrapping="Wrap"
                                       Text="ZIP, RAR, 7z, .package и .ts4script. Можно сразу много — менеджер сам распакует и разложит по папкам." />
                            <Button Style="{StaticResource PrimaryButton}" Content="Выбрать файлы" Margin="0,14,0,0"
                                    Command="{Binding BrowseFilesCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Equals}, ConverterParameter=False}" />
                        </StackPanel>
                    </Border>

                    <!-- Результат последней установки -->
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Последняя установка" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Style="{StaticResource GhostButton}" Content="Очистить" HorizontalAlignment="Right"
                                    Padding="6,2" FontSize="12" Command="{Binding ClearResultsCommand}" />
                        </Grid>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding LastResults}" Margin="0,8,0,0">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:InstallResultViewModel}">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Mark" Style="{StaticResource Icon}" Text="&#xE73E;" Margin="0,2,8,0"
                                                   VerticalAlignment="Top" Foreground="{StaticResource AccentBrush}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource MutedText}" Text="{Binding Message}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Succeeded}" Value="False">
                                            <Setter TargetName="Mark" Property="Text" Value="&#xE711;" />
                                            <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Строка состояния -->
            <Grid Grid.Row="3" Margin="0,10,0,0">
                <TextBlock Style="{StaticResource MutedText}" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" Margin="0,0,200,0" />
                <TextBlock Style="{StaticResource MutedText}" Text="{Binding SummaryText}" HorizontalAlignment="Right" />
            </Grid>
        </Grid>

        <!-- Затемнение при перетаскивании файлов в окно -->
        <Border x:Name="DropOverlay" Background="{StaticResource DropOverlayBrush}" Visibility="Collapsed" IsHitTestVisible="False">
            <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="3" CornerRadius="16" Margin="24">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="48" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Отпустите, чтобы установить" FontSize="22" FontWeight="SemiBold" Margin="0,14,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>

        <!-- Индикатор установки -->
        <Border Background="{StaticResource DropOverlayBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
                <TextBlock Text="Устанавливаю моды…" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,14,0,10"
                             Foreground="{StaticResource AccentBrush}" Background="{StaticResource Surface2Brush}" BorderThickness="0" />
                <TextBlock Style="{StaticResource MutedText}" Text="{Binding StatusText}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
