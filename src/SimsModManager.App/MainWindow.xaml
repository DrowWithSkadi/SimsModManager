<Window x:Class="SimsModManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SimsModManager.App.ViewModels"
        xmlns:views="clr-namespace:SimsModManager.App.Views"
        xmlns:ctl="clr-namespace:SimsModManager.App.Controls"
        xmlns:b="clr-namespace:SimsModManager.App.Behaviors"
        Title="Sims Mod Manager"
        Width="1100" Height="720" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource B.Background}"
        Foreground="{StaticResource B.Text}"
        FontFamily="{StaticResource Font.Ui}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        AllowDrop="True"
        DragEnter="OnDragEnter" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">

    <!-- Своя рамка окна: тёмный заголовок как в макете -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="28" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Border x:Name="RootBorder">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <!-- ═══ Заголовок окна ═══ -->
            <Grid Background="{StaticResource B.Surface}">
                <TextBlock Text="Sims Mod Manager" FontSize="11" Foreground="{StaticResource B.TextMuted}" VerticalAlignment="Center" Margin="16,0,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Btn.Caption}" Background="{StaticResource B.Hover}" ctl:Btn.Icon="{StaticResource Icon.Minus}"
                            Click="OnMinimize" ToolTip="Свернуть" />
                    <Button x:Name="MaxButton" Style="{StaticResource Btn.Caption}" Background="{StaticResource B.Hover}"
                            ctl:Btn.Icon="{StaticResource Icon.Square}" Click="OnMaximize" ToolTip="Развернуть" />
                    <Button Style="{StaticResource Btn.Caption}" Background="#C42B1C" ctl:Btn.Icon="{StaticResource Icon.X}"
                            Click="OnClose" ToolTip="Закрыть" />
                </StackPanel>
            </Grid>

            <!-- ═══ Шапка приложения ═══ -->
            <Border Grid.Row="1" Height="72" BorderBrush="{StaticResource B.Hover}" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Sims Mod Manager" Style="{StaticResource T.Title}" />
                        <TextBlock Text="{Binding SimsFolder}" FontSize="11" Foreground="{StaticResource B.TextMuted}" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis" Visibility="{Binding HasGame, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Visibility="{Binding HasGame, Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{StaticResource Btn.Secondary}" ctl:Btn.Icon="{StaticResource Icon.FolderOpen}" Content="Папка Mods"
                                Command="{Binding OpenModsFolderCommand}" ToolTip="Открыть папку Mods в проводнике" />
                        <Button Style="{StaticResource Btn.Secondary}" ctl:Btn.Icon="{StaticResource Icon.BrushCleaning}" Content="Очистить кэш" Margin="8,0,0,0"
                                Command="{Binding ClearCacheCommand}"
                                ToolTip="Удаляет localthumbcache.package. Помогает, если после установки модов в игре видны старые или сломанные вещи." />
                        <Button Style="{StaticResource Btn.Secondary}" ctl:Btn.Icon="{StaticResource Icon.Settings}" Content="Настройки" Margin="8,0,0,0"
                                Command="{Binding OpenSettingsCommand}"
                                Visibility="{Binding IsCompact, Converter={StaticResource InverseBoolToVisibility}}" />
                        <Button Style="{StaticResource Btn.Icon}" ctl:Btn.Icon="{StaticResource Icon.Settings}" Margin="8,0,0,0" ToolTip="Настройки"
                                Command="{Binding OpenSettingsCommand}"
                                Visibility="{Binding IsCompact, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <Border Style="{StaticResource Tag}" Background="{StaticResource B.AccentSubtle}" HorizontalAlignment="Right"
                            Visibility="{Binding HasGame, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Style="{StaticResource TagText}" Text="Первый запуск" Foreground="{StaticResource B.Accent}" />
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ Страницы ═══ -->
            <Grid Grid.Row="2">
                <views:LibraryPage x:Name="Library" b:Anim.Show="{Binding ShowLibraryChrome}" b:Anim.Offset="0" />
                <views:SettingsPage b:Anim.Show="{Binding IsSettingsPage}" />
                <views:NotFoundPage b:Anim.Show="{Binding IsNotFoundPage}" />

                <!-- Панель выбора нескольких модов -->
                <Border VerticalAlignment="Bottom" Background="#1E2B27" BorderBrush="{StaticResource B.Accent}" BorderThickness="0,1,0,0"
                        Padding="24,10" b:Anim.Show="{Binding IsMultiSelect}" b:Anim.Offset="16">
                    <Grid>
                        <TextBlock Text="{Binding SelectionText}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource B.Accent}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource Btn.Primary}" Content="Включить" Command="{Binding EnableSelectedCommand}" />
                            <Button Style="{StaticResource Btn.Secondary}" Content="Выключить" Margin="8,0,0,0" Command="{Binding DisableSelectedCommand}" />
                            <Button Style="{StaticResource Btn.Danger}" ctl:Btn.Icon="{StaticResource Icon.Trash2}" Content="Удалить" Margin="8,0,0,0"
                                    Command="{Binding DeleteSelectedCommand}" />
                            <Button Style="{StaticResource Btn.Secondary}" Content="Снять выделение" Margin="8,0,0,0" Command="{Binding ClearSelectionCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Уведомления -->
                <ItemsControl ItemsSource="{Binding Toasts}" ItemTemplate="{StaticResource ToastItem}" VerticalAlignment="Bottom"
                              HorizontalAlignment="Center" Margin="0,0,0,16" Focusable="False">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMultiSelect}" Value="True">
                                    <Setter Property="Margin" Value="0,0,0,72" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
            </Grid>

            <!-- ═══ Строка состояния ═══ -->
            <Grid Grid.Row="3" Background="{StaticResource B.Surface}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Ellipse Width="5" Height="5" Fill="{StaticResource B.Accent}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding LastActionText}" FontSize="10" Foreground="{StaticResource B.TextSecondary}" />
                </StackPanel>
                <TextBlock Text="{Binding SummaryText}" FontSize="11" Foreground="{StaticResource B.TextSecondary}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Margin="0,0,24,0" Visibility="{Binding HasGame, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="Данные остаются на вашем компьютере" FontSize="11" Foreground="{StaticResource B.TextSecondary}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Margin="0,0,24,0" Visibility="{Binding HasGame, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>

            <!-- ═══ Перетаскивание файлов ═══ -->
            <Grid Grid.Row="1" Grid.RowSpan="3" Background="{StaticResource B.DropOverlay}" IsHitTestVisible="False"
                  b:Anim.Show="{Binding IsDragOver}" b:Anim.Offset="0">
                <Rectangle Margin="32" RadiusX="12" RadiusY="12" Stroke="{StaticResource B.Accent}" StrokeThickness="1.5" StrokeDashArray="6 4"
                           Fill="#14FFFFFF" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ctl:IconView Data="{StaticResource Icon.Download}" Foreground="{StaticResource B.Accent}" Width="36" Height="36" />
                    <TextBlock Text="Отпустите, чтобы установить" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource B.Text}"
                               HorizontalAlignment="Center" Margin="0,18,0,12" />
                    <Border Style="{StaticResource Tag}" Background="{StaticResource B.AccentSubtle}" HorizontalAlignment="Center" Height="22" Padding="10,0">
                        <TextBlock Style="{StaticResource TagText}" Text="{Binding DragCountText}" Foreground="{StaticResource B.Accent}" FontSize="11" />
                    </Border>
                    <TextBlock Text="ZIP / RAR / 7z / .package / .ts4script" Style="{StaticResource T.Secondary}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </Grid>

            <!-- ═══ Идёт установка ═══ -->
            <Grid Grid.Row="1" Grid.RowSpan="3" Background="{StaticResource B.Overlay}" b:Anim.Show="{Binding IsInstalling}" b:Anim.Offset="0">
                <Border Style="{StaticResource Card}" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24,22"
                        b:Anim.Show="{Binding IsInstalling}" b:Anim.Scale="0.96">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.5" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ctl:IconView Data="{StaticResource Icon.PackageOpen}" Foreground="{StaticResource B.Accent}" Width="22" Height="22" />
                            <TextBlock Text="Устанавливаю моды…" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource B.Text}" Margin="12,0,0,0" />
                        </StackPanel>
                        <Grid Margin="0,20,0,8">
                            <TextBlock Text="{Binding InstallCountText}" Style="{StaticResource T.Secondary}" />
                            <TextBlock Text="{Binding InstallPercentText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource B.Accent}" HorizontalAlignment="Right" />
                        </Grid>
                        <ProgressBar Style="{StaticResource Progress}" Maximum="100" b:Anim.SmoothValue="{Binding InstallPercent}" />
                        <TextBlock Text="{Binding InstallCurrent}" Style="{StaticResource T.Secondary}" FontSize="11" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Распаковываем архивы и раскладываем файлы по папкам. Это займёт несколько секунд." Style="{StaticResource T.Muted}"
                                   TextWrapping="Wrap" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ Диалог ═══ -->
            <Grid Grid.Row="0" Grid.RowSpan="4" Background="{StaticResource B.Overlay}" b:Anim.Show="{Binding HasDialog}" b:Anim.Offset="0"
                  MouseLeftButtonDown="OnOverlayClick">
                <Border Style="{StaticResource Card}" Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20"
                        DataContext="{Binding DisplayedDialog}" b:Anim.Show="{Binding DataContext.HasDialog, RelativeSource={RelativeSource AncestorType=Window}}"
                        b:Anim.Scale="0.96" MouseLeftButtonDown="OnDialogClick">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.5" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ctl:IconView x:Name="DialogIcon" Data="{Binding Icon}" Width="18" Height="18" VerticalAlignment="Top" Margin="0,3,12,0">
                                <ctl:IconView.Style>
                                    <Style TargetType="ctl:IconView" BasedOn="{StaticResource {x:Type ctl:IconView}}">
                                        <Setter Property="Foreground" Value="{StaticResource B.Accent}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IconIsDanger}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource B.Error}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ctl:IconView.Style>
                            </ctl:IconView>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource B.Text}" TextWrapping="Wrap" />
                            <Button Grid.Column="2" Style="{StaticResource Btn.IconGhost}" ctl:Btn.Icon="{StaticResource Icon.X}" Command="{Binding CancelCommand}"
                                    Margin="8,-4,-6,0" VerticalAlignment="Top" ToolTip="Закрыть (Esc)" />
                        </Grid>
                        <TextBlock Text="{Binding Message}" Style="{StaticResource T.Secondary}" TextWrapping="Wrap" LineHeight="18" Margin="0,14,0,0"
                                   Visibility="{Binding Message, Converter={StaticResource NullToVisibility}}" />

                        <Border Background="{StaticResource B.Background}" BorderBrush="{StaticResource B.Border}" BorderThickness="1" CornerRadius="6"
                                Padding="12,10" Margin="0,14,0,0" Visibility="{Binding HasInfo, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{Binding InfoTitle}" Style="{StaticResource T.Strong}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding InfoSubtitle}" Style="{StaticResource T.Muted}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource B.Background}" BorderBrush="{StaticResource B.Border}" BorderThickness="1" CornerRadius="6"
                                Height="32" Padding="10,0" Margin="0,14,0,0" Visibility="{Binding HasPath, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding PathText}" FontSize="11" Foreground="{StaticResource B.TextSecondary}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>

                        <Border Background="{StaticResource B.Background}" BorderBrush="{StaticResource B.Border}" BorderThickness="1" CornerRadius="6"
                                Padding="12,10" Margin="0,14,0,0" MaxHeight="160" Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                         Foreground="{StaticResource B.TextMuted}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>

                        <TextBlock Text="{Binding Message2}" Style="{StaticResource T.Secondary}" TextWrapping="Wrap" LineHeight="18" Margin="0,14,0,0"
                                   Visibility="{Binding HasMessage2, Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <TextBlock Text="Скопировано" Style="{StaticResource T.Muted}" Foreground="{StaticResource B.Accent}" VerticalAlignment="Center"
                                       Margin="0,0,12,0" Visibility="{Binding Copied, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource Btn.Secondary}" Content="{Binding ExtraText}" Command="{Binding ExtraCommand}" Margin="0,0,8,0"
                                    Visibility="{Binding HasExtra, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource Btn.Secondary}" Content="{Binding SecondaryText}" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                                    Visibility="{Binding HasSecondary, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PrimaryIsDanger}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource B.ErrorSubtle}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource B.ErrorBorder}" />
                                                <Setter Property="Foreground" Value="{StaticResource B.Error}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
