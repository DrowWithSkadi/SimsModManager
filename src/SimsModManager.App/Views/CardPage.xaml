<UserControl x:Class="SimsModManager.App.Views.CardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SimsModManager.App.Controls"
             xmlns:b="clr-namespace:SimsModManager.App.Behaviors">
    <!-- DataContext — MainViewModel, сама карточка — в свойстве Card -->
    <Grid Margin="24,20,24,16" DataContext="{Binding Card}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <Button Style="{StaticResource Btn.Icon}" ctl:Btn.Icon="{StaticResource Icon.ArrowLeft}" ToolTip="Назад (Esc)" VerticalAlignment="Top" Margin="0,2,16,0"
                    Command="{Binding DataContext.CloseCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <StackPanel>
                <TextBlock Text="Карточка мода" Style="{StaticResource T.Page}" />
                <TextBlock Text="{Binding Breadcrumb}" Style="{StaticResource T.Secondary}" Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="304" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Слева: картинка и расцветки -->
            <StackPanel b:Anim.Appear="True">
                <Border Height="340" CornerRadius="8" Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Border}" BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <ctl:IconView Data="{StaticResource Icon.Image}" Width="40" Height="40" Foreground="{StaticResource B.TextMuted}"
                                      Visibility="{Binding HasImage, Converter={StaticResource InverseBoolToVisibility}}" />
                        <Image Source="{Binding Image}" Stretch="Uniform" Margin="12" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>
                <ItemsControl ItemsSource="{Binding Items[0].SwatchImages}" Margin="0,12,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="56" Height="56" CornerRadius="6" Background="{StaticResource B.Control}" Margin="0,0,8,8" ClipToBounds="True"
                                    b:Anim.Appear="True">
                                <Image Source="{Binding}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding ItemsSummary}" Style="{StaticResource T.Muted}" />
            </StackPanel>

            <!-- Справа: сведения -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel b:Anim.Appear="True">
                    <Grid>
                        <TextBlock Text="{Binding Mod.Name}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource B.Text}"
                                   TextWrapping="Wrap" Margin="0,0,56,0" />
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Mod.IsEnabled}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Margin="0,6,0,0" ToolTip="Включить / выключить мод" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Border Style="{StaticResource Tag}" Margin="0,0,6,0" Visibility="{Binding Mod.ShowCategory, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource TagText}" Text="{Binding Mod.CategoryLabel}" />
                        </Border>
                        <Border Style="{StaticResource Tag}" Background="{StaticResource B.AccentSubtle}" Margin="0,0,6,0"
                                Visibility="{Binding IsModified, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource TagText}" Text="Изменён" Foreground="{StaticResource B.Accent}" />
                        </Border>
                        <Border Style="{StaticResource Tag}" Background="{StaticResource B.AccentSubtle}" Margin="0,0,6,0"
                                Visibility="{Binding Mod.ShowScriptBadge, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource TagText}" Text="Скрипт" Foreground="{StaticResource B.Accent}" />
                        </Border>
                        <Border Style="{StaticResource Tag}" Background="#1F3A2F" Visibility="{Binding Mod.IsEnabled, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource TagText}" Text="Включён" Foreground="{StaticResource B.Accent}" />
                        </Border>
                        <Border Style="{StaticResource Tag}" Visibility="{Binding Mod.IsEnabled, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Style="{StaticResource TagText}" Text="Выключен" Foreground="{StaticResource B.TextMuted}" />
                        </Border>
                    </StackPanel>

                    <!-- Сведения -->
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="110" />
                            <ColumnDefinition Width="Auto" MinWidth="90" />
                            <ColumnDefinition Width="Auto" MinWidth="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Установлен" Style="{StaticResource T.Muted}" />
                            <TextBlock Text="{Binding InstalledText}" Style="{StaticResource T.Body}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Размер" Style="{StaticResource T.Muted}" />
                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource T.Body}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Файлы" Style="{StaticResource T.Muted}" />
                            <TextBlock Text="{Binding FilesSummary}" Style="{StaticResource T.Body}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <ctl:IconView Data="{StaticResource Icon.Folder}" Foreground="{StaticResource B.TextSecondary}" Width="14" Height="14" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding LocationText}" Style="{StaticResource T.Secondary}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Вещи внутри мода -->
                    <TextBlock Text="Читаю вещи из файлов…" Style="{StaticResource T.Muted}" Margin="0,18,0,0"
                               Visibility="{Binding IsLoadingItems, Converter={StaticResource BoolToVisibility}}" />

                    <ItemsControl ItemsSource="{Binding Items}" Margin="0,16,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10" b:Anim.Appear="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource T.Strong}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource T.Secondary}" Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding OutfitsText}" Style="{StaticResource T.Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <ItemsControl ItemsSource="{Binding SwatchImages}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="22" Height="22" CornerRadius="4" Background="{StaticResource B.Control}"
                                                                    BorderBrush="{StaticResource B.Border}" BorderThickness="1" Margin="0,0,6,0" ClipToBounds="True">
                                                                <Image Source="{Binding}" Stretch="UniformToFill" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding MoreSwatchesText}" Style="{StaticResource T.Muted}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource Btn.Primary}" ctl:Btn.Icon="{StaticResource Icon.SlidersHorizontal}"
                                                Content="Настроить" VerticalAlignment="Top" Margin="12,0,0,0"
                                                Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Style="{StaticResource Btn.Secondary}" ctl:Btn.Icon="{StaticResource Icon.SlidersHorizontal}" Content="Настроить все вещи сразу"
                            HorizontalAlignment="Left" Margin="0,0,0,10"
                            Command="{Binding DataContext.EditAllItemsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Visibility="{Binding HasManyItems, Converter={StaticResource BoolToVisibility}}" />

                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,16,0,10"
                            Visibility="{Binding ShowNoItems, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <ctl:IconView Data="{StaticResource Icon.Info}" Foreground="{StaticResource B.TextSecondary}" VerticalAlignment="Top" Margin="0,1,12,0" />
                            <TextBlock Text="{Binding NoItemsText}" Style="{StaticResource T.Secondary}" TextWrapping="Wrap" MaxWidth="520" />
                        </StackPanel>
                    </Border>

                    <!-- Файлы мода -->
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,10">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding FilesExpanded}" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent" Height="36" Margin="16,0">
                                            <StackPanel Orientation="Horizontal">
                                                <ctl:IconView x:Name="Chevron" Data="{StaticResource Icon.ChevronRight}" Width="14" Height="14"
                                                              Foreground="{StaticResource B.TextSecondary}" RenderTransformOrigin="0.5,0.5">
                                                    <ctl:IconView.RenderTransform>
                                                        <RotateTransform Angle="0" />
                                                    </ctl:IconView.RenderTransform>
                                                </ctl:IconView>
                                                <ctl:IconView Data="{StaticResource Icon.Files}" Width="14" Height="14" Foreground="{StaticResource B.TextSecondary}" Margin="10,0,10,0" />
                                                <TextBlock Text="Файлы мода" Style="{StaticResource T.Body}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding FilesHeader}" Style="{StaticResource T.Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             To="90" Duration="0:0:0.15" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             To="0" Duration="0:0:0.15" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ItemsControl ItemsSource="{Binding Files}" Margin="16,0,16,10" b:Anim.Show="{Binding FilesExpanded}" b:Anim.Offset="-4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource T.Secondary}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,80,0" />
                                            <TextBlock Text="{Binding Size}" Style="{StaticResource T.Muted}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Проблемы -->
                    <Border Background="{StaticResource B.WarningSubtle}" BorderBrush="{StaticResource B.WarningBorder}" BorderThickness="1" CornerRadius="8"
                            Padding="16,12" Visibility="{Binding Mod.HasProblems, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <ctl:IconView Data="{StaticResource Icon.TriangleAlert}" Foreground="{StaticResource B.Warning}" VerticalAlignment="Top" Margin="0,1,12,0" />
                            <StackPanel>
                                <TextBlock Text="Есть проблемы" Style="{StaticResource T.Strong}" FontSize="12" />
                                <TextBlock Text="{Binding Mod.ProblemsText}" Style="{StaticResource T.Secondary}" TextWrapping="Wrap" MaxWidth="520" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Действия -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Btn.Secondary}" ctl:Btn.Icon="{StaticResource Icon.FolderOpen}" Content="Показать в проводнике"
                        Command="{Binding DataContext.OpenModLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding Mod}" />
                <Button Style="{StaticResource Btn.Danger}" ctl:Btn.Icon="{StaticResource Icon.Trash2}" Content="Удалить" Margin="8,0,0,0"
                        Command="{Binding DataContext.DeleteFromCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding IsModified, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Оригинал сохранён" Style="{StaticResource T.Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Style="{StaticResource Btn.Secondary}" ctl:Btn.Icon="{StaticResource Icon.RotateCcw}" Content="Вернуть оригинал"
                        Command="{Binding DataContext.RestoreOriginalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
