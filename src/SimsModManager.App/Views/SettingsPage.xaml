<UserControl x:Class="SimsModManager.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:l="clr-namespace:SimsModManager.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SimsModManager.App.Controls"
             xmlns:b="clr-namespace:SimsModManager.App.Behaviors">
    <UserControl.Resources>
        <!-- Плитка выбора темы: мини-превью + название, выбранная — с акцентной рамкой -->
        <Style x:Key="ThemeOption" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8" BorderThickness="1.5" BorderBrush="{DynamicResource B.Border}"
                                Background="{DynamicResource B.Control}" Padding="6">
                            <StackPanel>
                                <ContentPresenter Content="{TemplateBinding Tag}" Height="44" />
                                <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="11" Margin="2,6,0,0"
                                           Foreground="{DynamicResource B.TextSecondary}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.BorderHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.Accent}" />
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource B.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,24,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button Style="{StaticResource Btn.Icon}" ctl:Btn.Icon="{StaticResource Icon.ArrowLeft}" ToolTip="{l:Tr 'Назад (Esc)'}"
                        Command="{Binding GoLibraryCommand}" VerticalAlignment="Top" Margin="0,2,16,0" />
                <StackPanel>
                    <TextBlock Text="{l:Tr 'Настройки программы'}" Style="{StaticResource T.Page}" />
                    <TextBlock Text="{l:Tr 'Игра, файлы и поведение менеджера'}" Style="{StaticResource T.Secondary}" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" MaxWidth="420" />
                </Grid.ColumnDefinitions>

                <!-- Левая колонка -->
                <StackPanel>
                    <!-- Папка игры -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" b:Anim.Appear="True">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{l:Tr 'Папка The Sims 4'}" Style="{StaticResource T.Section}" />
                                <Border Style="{StaticResource Tag}" Background="{DynamicResource B.AccentSubtle}" HorizontalAlignment="Right"
                                        Visibility="{Binding FolderLooksValid, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource TagText}" Text="{l:Tr 'Найдена'}" Foreground="{DynamicResource B.Accent}" />
                                </Border>
                                <Border Style="{StaticResource Tag}" Background="{DynamicResource B.WarningSubtle}" HorizontalAlignment="Right"
                                        Visibility="{Binding FolderLooksValid, Converter={StaticResource InverseBoolToVisibility}}">
                                    <TextBlock Style="{StaticResource TagText}" Text="{l:Tr 'Не подтверждена'}" Foreground="{DynamicResource B.Warning}" />
                                </Border>
                            </Grid>
                            <Border Background="{DynamicResource B.Background}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                                    CornerRadius="6" Height="32" Padding="10,0" Margin="0,14,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <ctl:IconView Data="{StaticResource Icon.Folder}" Foreground="{DynamicResource B.Accent}" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding SimsFolderShown}" FontSize="12" Foreground="{DynamicResource B.Text}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Btn.Secondary}" ctl:Btn.Icon="{StaticResource Icon.FolderOpen}" Content="{l:Tr 'Изменить'}"
                                        Command="{Binding ChooseFolderCommand}" />
                                <Button Style="{StaticResource Btn.Secondary}" ctl:Btn.Icon="{StaticResource Icon.Search}" Content="{l:Tr 'Найти автоматически'}"
                                        Command="{Binding AutoFindFolderCommand}" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Моды в игре -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" b:Anim.Appear="True">
                        <StackPanel>
                            <TextBlock Text="{l:Tr 'Моды в игре'}" Style="{StaticResource T.Section}" Margin="0,0,0,12" />
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{l:Tr 'Пользовательский контент и моды'}" Style="{StaticResource T.Strong}" FontSize="12" />
                                    <TextBlock Text="{l:Tr 'Изменяет параметр в Options.ini'}" Style="{StaticResource T.Muted}" Margin="0,3,0,0" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding GameModsEnabled}"
                                          IsEnabled="{Binding OptionsFileFound}" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource B.Hover}" Margin="0,12" />
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{l:Tr 'Скриптовые моды'}" Style="{StaticResource T.Strong}" FontSize="12" />
                                    <TextBlock Text="{l:Tr 'Вступит в силу после перезапуска игры'}" Style="{StaticResource T.Muted}" Margin="0,3,0,0" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding GameScriptsEnabled}"
                                          IsEnabled="{Binding OptionsFileFound}" />
                            </Grid>
                            <TextBlock Style="{StaticResource T.Muted}" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource B.Warning}"
                                       Text="{l:Tr 'Файла Options.ini пока нет — запустите игру один раз, и настройки станут доступны.'}"
                                       Visibility="{Binding OptionsFileFound, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <!-- Кэш -->
                    <Border Style="{StaticResource Card}" b:Anim.Appear="True">
                        <StackPanel>
                            <Grid>
                                <StackPanel Margin="0,0,140,0">
                                    <TextBlock Text="{l:Tr 'Кэш игры'}" Style="{StaticResource T.Strong}" FontSize="12" />
                                    <TextBlock Text="{l:Tr 'Удаляет localthumbcache.package, не затрагивая сохранения.'}" Style="{StaticResource T.Muted}"
                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Style="{StaticResource Btn.Secondary}" ctl:Btn.Icon="{StaticResource Icon.BrushCleaning}" Content="{l:Tr 'Очистить кэш'}"
                                        HorizontalAlignment="Right" Command="{Binding ClearCacheCommand}" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource B.Hover}" Margin="0,12" />
                            <Grid>
                                <TextBlock Text="{l:Tr 'Очищать кэш после установки'}" Style="{StaticResource T.Strong}" FontSize="12" VerticalAlignment="Center" />
                                <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding AutoClearCache}" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource B.Hover}" Margin="0,12" />
                            <Grid>
                                <TextBlock Text="{l:Tr 'Анимация с логотипом при запуске'}" Style="{StaticResource T.Strong}" FontSize="12" VerticalAlignment="Center" />
                                <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding ShowSplash}" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource B.Hover}" Margin="0,12" />
                            <Grid>
                                <TextBlock Text="{l:Tr 'Коробок — помощник в шапке'}" Style="{StaticResource T.Strong}" FontSize="12" VerticalAlignment="Center" />
                                <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding ShowMascot}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Правая колонка -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" b:Anim.Appear="True">
                        <StackPanel>
                            <TextBlock Text="{l:Tr 'Удаление файлов'}" Style="{StaticResource T.Section}" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,10">
                                <RadioButton Style="{StaticResource ChipRadio}" Content="{l:Tr 'В корзину'}" GroupName="DeleteMode"
                                             IsChecked="{Binding DeleteToRecycleBin}" />
                                <RadioButton Style="{StaticResource ChipRadio}" Content="{l:Tr 'Насовсем'}" GroupName="DeleteMode" Margin="4,0,0,0"
                                             IsChecked="{Binding DeleteToRecycleBin, Converter={StaticResource InverseBool}}" />
                            </StackPanel>
                            <TextBlock Text="{l:Tr 'Рекомендуем корзину: удалённые моды можно восстановить.'}" Style="{StaticResource T.Muted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Язык интерфейса: меняется сразу, без перезапуска -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" b:Anim.Appear="True">
                        <StackPanel>
                            <TextBlock Text="{l:Tr 'Язык'}" Style="{StaticResource T.Section}" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,10">
                                <RadioButton Style="{StaticResource ChipRadio}" Content="{l:Tr 'Как в Windows'}" GroupName="Language"
                                             IsChecked="{Binding Language, Converter={StaticResource Equals}, ConverterParameter=auto, Mode=OneWay}"
                                             Command="{Binding SetLanguageCommand}" CommandParameter="auto" />
                                <RadioButton Style="{StaticResource ChipRadio}" Content="Русский" GroupName="Language" Margin="4,0,0,0"
                                             IsChecked="{Binding Language, Converter={StaticResource Equals}, ConverterParameter=ru, Mode=OneWay}"
                                             Command="{Binding SetLanguageCommand}" CommandParameter="ru" />
                                <RadioButton Style="{StaticResource ChipRadio}" Content="English" GroupName="Language" Margin="4,0,0,0"
                                             IsChecked="{Binding Language, Converter={StaticResource Equals}, ConverterParameter=en, Mode=OneWay}"
                                             Command="{Binding SetLanguageCommand}" CommandParameter="en" />
                            </StackPanel>
                            <TextBlock Text="{l:Tr 'Язык меняется сразу. Названия модов и файлов остаются как есть.'}" Style="{StaticResource T.Muted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" b:Anim.Appear="True">
                        <StackPanel>
                            <TextBlock Text="{l:Tr 'Оформление'}" Style="{StaticResource T.Section}" />
                            <TextBlock Text="{Binding ThemeLabel}" Style="{StaticResource T.Secondary}" Margin="0,4,0,12" />
                            <UniformGrid Columns="3">
                                <!-- Тёмная -->
                                <RadioButton Style="{StaticResource ThemeOption}" GroupName="Theme" Content="{l:Tr 'Тёмная'}" Margin="0,0,6,0"
                                             IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Dark, Mode=OneWay}"
                                             Command="{Binding SetThemeCommand}" CommandParameter="Dark">
                                    <RadioButton.Tag>
                                        <Border Background="#191919" CornerRadius="4" Padding="5">
                                            <StackPanel>
                                                <Border Height="4" Width="26" Background="#B8B8B4" CornerRadius="1" HorizontalAlignment="Left" />
                                                <Border Height="10" Background="#2B2B2B" CornerRadius="2" Margin="0,4,0,0" />
                                                <Border Height="6" Width="18" Background="#77E1C7" CornerRadius="1" HorizontalAlignment="Left" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </RadioButton.Tag>
                                </RadioButton>
                                <!-- Светлая -->
                                <RadioButton Style="{StaticResource ThemeOption}" GroupName="Theme" Content="{l:Tr 'Светлая'}" Margin="3,0,3,0"
                                             IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Light, Mode=OneWay}"
                                             Command="{Binding SetThemeCommand}" CommandParameter="Light">
                                    <RadioButton.Tag>
                                        <Border Background="#F4F1EA" CornerRadius="4" Padding="5">
                                            <StackPanel>
                                                <Border Height="4" Width="26" Background="#5F5B53" CornerRadius="1" HorizontalAlignment="Left" />
                                                <Border Height="10" Background="#FBFAF6" BorderBrush="#DCD5C7" BorderThickness="1" CornerRadius="2" Margin="0,4,0,0" />
                                                <Border Height="6" Width="18" Background="#2B9C82" CornerRadius="1" HorizontalAlignment="Left" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </RadioButton.Tag>
                                </RadioButton>
                                <!-- Стекло -->
                                <RadioButton Style="{StaticResource ThemeOption}" GroupName="Theme" Content="{l:Tr 'Стекло'}" Margin="6,0,0,0"
                                             IsEnabled="{Binding GlassSupported}"
                                             IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Glass, Mode=OneWay}"
                                             Command="{Binding SetThemeCommand}" CommandParameter="Glass">
                                    <RadioButton.Tag>
                                        <Border CornerRadius="4" Padding="5">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#3B4C5A" Offset="0" />
                                                    <GradientStop Color="#2A3B36" Offset="0.55" />
                                                    <GradientStop Color="#4A3B52" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <StackPanel>
                                                <Border Height="4" Width="26" Background="#CCFFFFFF" CornerRadius="1" HorizontalAlignment="Left" />
                                                <Border Height="10" Background="#26FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="2" Margin="0,4,0,0" />
                                                <Border Height="6" Width="18" Background="#82EACF" CornerRadius="1" HorizontalAlignment="Left" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </RadioButton.Tag>
                                </RadioButton>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource T.Muted}" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Text="{l:Tr '«Стекло» — полупрозрачное окно с размытием фона. Нужна Windows 11.'}"
                                       Visibility="{Binding GlassSupported, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <!-- Оверлей и точки сохранения -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" b:Anim.Appear="True">
                        <StackPanel>
                            <TextBlock Text="{l:Tr 'Оверлей в игре'}" Style="{StaticResource T.Section}" />
                            <TextBlock Style="{StaticResource T.Muted}" TextWrapping="Wrap" Margin="0,4,0,12"
                                       Text="{l:Tr 'Точки сохранения прямо в игре по нажатию клавиши. Нужен режим «На весь экран в окне» или «В окне».'}" />
                            <Grid>
                                <TextBlock Text="{l:Tr 'Включить оверлей'}" Style="{StaticResource T.Strong}" FontSize="12" VerticalAlignment="Center" />
                                <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding OverlayEnabled}" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource B.Hover}" Margin="0,12" />
                            <Grid IsEnabled="{Binding OverlayEnabled}">
                                <TextBlock Text="{l:Tr 'Клавиша'}" Style="{StaticResource T.Strong}" FontSize="12" VerticalAlignment="Center" />
                                <Button x:Name="HotkeyButton" HorizontalAlignment="Right" MinWidth="96" Command="{Binding RecordHotkeyCommand}"
                                        PreviewKeyDown="OnHotkeyKeyDown" ToolTip="{l:Tr 'Нажми и затем нужную клавишу или сочетание'}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Btn.Secondary}">
                                            <Setter Property="Content" Value="{Binding OverlayHotkey}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRecordingHotkey}" Value="True">
                                                    <Setter Property="Content" Value="{l:Tr 'Нажми клавишу…'}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding OverlayProblem}" Foreground="{DynamicResource B.Error}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OverlayProblem}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Height="1" Background="{DynamicResource B.Hover}" Margin="0,12" />
                            <Grid IsEnabled="{Binding OverlayEnabled}">
                                <TextBlock Text="{l:Tr 'Пауза в игре, пока открыт оверлей'}" Style="{StaticResource T.Strong}" FontSize="12" VerticalAlignment="Center" />
                                <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding OverlayPausesGame}" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource B.Hover}" Margin="0,12" />
                            <Grid IsEnabled="{Binding OverlayEnabled}">
                                <StackPanel Margin="0,0,56,0">
                                    <TextBlock Text="{l:Tr 'Скрывать на стриме и в записи'}" Style="{StaticResource T.Strong}" FontSize="12" />
                                    <TextBlock Text="{l:Tr 'Ты видишь оверлей, а OBS, Discord и запись экрана — нет'}" Style="{StaticResource T.Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding OverlayHideFromCapture}" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource B.Hover}" Margin="0,12" />
                            <Grid>
                                <TextBlock Text="{l:Tr 'Мод-помощник'}" Style="{StaticResource T.Strong}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding HelperStatusText}" Style="{StaticResource T.Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" b:Anim.Appear="True">
                        <StackPanel>
                            <TextBlock Text="{l:Tr 'Точки сохранения'}" Style="{StaticResource T.Section}" />
                            <TextBlock Text="{Binding CheckpointStorageText}" Style="{StaticResource T.Muted}" Margin="0,4,0,12" />
                            <TextBlock Text="{l:Tr 'Автоудаление — пустое поле значит «не удалять». Закреплённые точки не удаляются никогда.'}"
                                       Style="{StaticResource T.Muted}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{l:Tr 'Удалять старше, дней'}" Style="{StaticResource T.Strong}" FontSize="12" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource Input}" Width="90" HorizontalAlignment="Right"
                                         Text="{Binding CheckpointMaxAgeDays, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{l:Tr 'Хранить не больше, штук'}" Style="{StaticResource T.Strong}" FontSize="12" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource Input}" Width="90" HorizontalAlignment="Right"
                                         Text="{Binding CheckpointMaxCount, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="{l:Tr 'Занимать не больше, МБ'}" Style="{StaticResource T.Strong}" FontSize="12" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource Input}" Width="90" HorizontalAlignment="Right"
                                         Text="{Binding CheckpointMaxTotalMegabytes, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                            </Grid>
                            <Button Style="{StaticResource Btn.Secondary}" Content="{l:Tr 'Открыть папку с точками'}" HorizontalAlignment="Left"
                                    Command="{Binding OpenCheckpointsFolderCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- Дополнения игры -->
                    <Border Style="{StaticResource Card}" b:Anim.Appear="True" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{l:Tr 'Дополнения игры'}" Style="{StaticResource T.Section}" />
                            <TextBlock Text="{Binding PacksSummary}" Style="{StaticResource T.Muted}" TextWrapping="Wrap" Margin="0,4,0,10" />
                            <ItemsControl ItemsSource="{Binding PackRows}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,6,6" ToolTip="{Binding Tooltip}">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Tag}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPartial}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource B.WarningSubtle}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Name}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TagText}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPartial}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource B.Warning}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{l:Tr 'Жёлтые — установлены не полностью: есть только обновления, без основных файлов. Вещи из них будут невидимыми или «квадратами».'}"
                                       Style="{StaticResource T.Muted}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource B.Warning}"
                                       Visibility="{Binding HasPartialPacks, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" b:Anim.Appear="True">
                        <StackPanel>
                            <TextBlock Text="{l:Tr 'О программе'}" Style="{StaticResource T.Section}" />
                            <Grid Margin="0,12,0,6">
                                <TextBlock Text="Sims Mod Manager" Style="{StaticResource T.Strong}" FontSize="12" VerticalAlignment="Center" />
                                <Border Style="{StaticResource Tag}" HorizontalAlignment="Right">
                                    <TextBlock Style="{StaticResource TagText}" Text="{Binding VersionText}" />
                                </Border>
                            </Grid>
                            <TextBlock Style="{StaticResource T.Secondary}" TextWrapping="Wrap" LineHeight="17"
                                       Text="{l:Tr 'Ваши моды остаются на компьютере. Открытый исходный код, без аккаунта и облака.'}" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,10">
                                <Button Style="{StaticResource Btn.Secondary}" ctl:Btn.Icon="{StaticResource Icon.ExternalLink}" Content="GitHub"
                                        Command="{Binding OpenGitHubCommand}" />
                                <Button Style="{StaticResource Btn.Secondary}" Content="{l:Tr 'Проверить обновления'}" Margin="8,0,0,0"
                                        Command="{Binding CheckUpdatesCommand}" IsEnabled="{Binding IsCheckingUpdates, Converter={StaticResource InverseBool}}" />
                            </StackPanel>
                            <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource T.Muted}" TextWrapping="Wrap"
                                       Visibility="{Binding UpdateStatus, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
