<UserControl x:Class="SimsModManager.App.Controls.SideBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SimsModManager.App.Controls"
             xmlns:b="clr-namespace:SimsModManager.App.Behaviors"
             x:Name="Self">
    <!-- Боковая панель. Свёрнута — 64 px, только иконки и квадратная кнопка ▶.
         Наводишь мышку — выезжает поверх страницы (236 px): видны названия и полная кнопка «Играть».
         Логика раскрытия — в SideBar.xaml.cs. -->
    <UserControl.Resources>
        <Style x:Key="SideItem" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource B.TextSecondary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Bg" CornerRadius="10" Background="Transparent" />
                            <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="0,12" CornerRadius="1.5"
                                    Background="{DynamicResource B.Accent}" Opacity="0" />
                            <ctl:IconView x:Name="Icon" Data="{TemplateBinding ctl:Btn.Icon}" Width="20" Height="20" Margin="14,0,0,0"
                                          HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                            <ContentPresenter Margin="48,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource B.Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource B.AccentSubtle}" />
                                <Setter TargetName="Bar" Property="Opacity" Value="1" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource B.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SideLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="Opacity" Value="{Binding LabelOpacity, ElementName=Self}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Квадратная кнопка ▶ в свёрнутой панели -->
        <Style x:Key="MiniPlay" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform x:Name="Scale" /></Grid.RenderTransform>
                            <Border x:Name="Glow" CornerRadius="14" Background="{DynamicResource B.Accent}" Margin="4,6,4,0" Opacity="0.3">
                                <Border.Effect><BlurEffect Radius="16" /></Border.Effect>
                            </Border>
                            <Border x:Name="Face" CornerRadius="14" Background="{DynamicResource B.Accent}" BorderBrush="#99FFFFFF" BorderThickness="1.5" />
                            <!-- Блик -->
                            <Border CornerRadius="14" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.2" EndPoint="1,0.8">
                                        <LinearGradientBrush.RelativeTransform><TranslateTransform x:Name="MiniShine" X="-1.2" /></LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#00FFFFFF" Offset="0.3" />
                                        <GradientStop Color="#80FFFFFF" Offset="0.5" />
                                        <GradientStop Color="#00FFFFFF" Offset="0.7" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <!-- Ждёт: треугольник и искорка в углу -->
                            <Path x:Name="Triangle" Data="M0,0 L0,16 L13,8 Z" Fill="{DynamicResource B.OnAccent}" Margin="3,0,0,0"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Path x:Name="Sparkle" Data="M4,0 L5,3 L8,4 L5,5 L4,8 L3,5 L0,4 L3,3 Z" Fill="{DynamicResource B.OnAccent}" Opacity="0.55"
                                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,8,0" />
                            <!-- Готовит игру -->
                            <Grid x:Name="Busy" Width="20" Height="20" Visibility="Collapsed">
                                <Ellipse Stroke="#3C5A52" StrokeThickness="3" />
                                <Path Data="M10,1.5 A8.5,8.5 0 0 1 18.5,10" Stroke="{DynamicResource B.Accent}" StrokeThickness="3" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform><RotateTransform x:Name="MiniSpinner" /></Path.RenderTransform>
                                </Path>
                            </Grid>
                            <!-- Игра идёт -->
                            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{DynamicResource B.Accent}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="0.6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.93" ScaleY="0.93" /></Setter.Value>
                                </Setter>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#1F3A33" />
                                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource B.Accent}" />
                                <Setter TargetName="Triangle" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Sparkle" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Busy" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#1A2421" />
                                <Setter TargetName="Face" Property="BorderBrush" Value="#3C5A52" />
                                <Setter TargetName="Glow" Property="Opacity" Value="0" />
                                <Setter TargetName="Triangle" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Sparkle" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Внешняя ширина — 64 (колонка окна); сама панель шире и выезжает поверх страницы -->
    <Border x:Name="Panel" Width="64" HorizontalAlignment="Left" ClipToBounds="True"
            Background="{DynamicResource B.StatusBar}" BorderBrush="{DynamicResource B.Hover}" BorderThickness="0,0,1,0">
        <Border.Effect>
            <DropShadowEffect x:Name="PanelShadow" BlurRadius="24" ShadowDepth="0" Opacity="0" Color="Black" />
        </Border.Effect>
        <Grid>
            <!-- Непрозрачный фон, когда панель раскрыта поверх страницы -->
            <Border x:Name="SolidBg" Background="{DynamicResource B.Popup}" Opacity="0" />

            <Grid Width="236" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Логотип -->
                <Border BorderBrush="{DynamicResource B.Hover}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/logo-mark.png" Width="44" Height="44"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Sims Mod" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource B.Text}" Margin="12,0,0,0"
                                   VerticalAlignment="Center" Opacity="{Binding LabelOpacity, ElementName=Self}" />
                    </StackPanel>
                </Border>

                <!-- Вкладки -->
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <Button Style="{StaticResource SideItem}" ctl:Btn.Icon="{StaticResource Icon.Package}" Command="{Binding GoLibraryCommand}"
                            Tag="{Binding SideLibrarySelected}" ToolTip="Моды">
                        <TextBlock Style="{StaticResource SideLabel}" Text="Моды" />
                    </Button>
                    <Button Style="{StaticResource SideItem}" ctl:Btn.Icon="{StaticResource Icon.Eye}" Command="{Binding OpenHealthCommand}"
                            Tag="{Binding IsHealthPage}" Visibility="{Binding HasGame, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Состояние модов: конфликты, сломанные моды, поиск виновника">
                        <Grid>
                            <TextBlock Style="{StaticResource SideLabel}" Text="Состояние" />
                            <!-- Счётчик проблем — на углу иконки -->
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-26,-10,0,0" MinWidth="16" Height="16" CornerRadius="8"
                                    Padding="4,0" Background="{DynamicResource B.Error}" IsHitTestVisible="False"
                                    b:Anim.Show="{Binding HasHealthBadge}" b:Anim.Offset="0">
                                <TextBlock Text="{Binding HealthBadgeText}" FontSize="9" FontWeight="SemiBold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource SideItem}" ctl:Btn.Icon="{StaticResource Icon.FolderOpen}" Command="{Binding OpenModsFolderCommand}"
                            Visibility="{Binding HasGame, Converter={StaticResource BoolToVisibility}}" ToolTip="Открыть папку Mods в проводнике">
                        <TextBlock Style="{StaticResource SideLabel}" Text="Папка Mods" />
                    </Button>
                </StackPanel>

                <!-- Настройки — внизу, над кнопкой «Играть» -->
                <Button Grid.Row="3" Style="{StaticResource SideItem}" ctl:Btn.Icon="{StaticResource Icon.Settings}" Command="{Binding OpenSettingsCommand}"
                        Tag="{Binding IsSettingsPage}" ToolTip="Настройки" Margin="8,2,8,8">
                    <TextBlock Style="{StaticResource SideLabel}" Text="Настройки" />
                </Button>

                <!-- Играть: квадрат в свёрнутой панели, полная кнопка в раскрытой -->
                <Grid Grid.Row="4" Height="64" Margin="0,0,0,12" Visibility="{Binding HasGame, Converter={StaticResource BoolToVisibility}}">
                    <Button x:Name="MiniPlayButton" Style="{StaticResource MiniPlay}" Width="48" Height="48" Margin="8,0,0,0"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Command="{Binding LaunchGameCommand}"
                            ToolTip="Играть" />
                    <ctl:PlayButton x:Name="FullPlay" Width="212" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Opacity="0" IsHitTestVisible="False"
                                    IsLaunching="{Binding IsLaunching}" IsRunning="{Binding IsGameRunning}" Progress="{Binding LaunchProgress}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
