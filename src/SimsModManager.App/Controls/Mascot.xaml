<UserControl x:Class="SimsModManager.App.Controls.Mascot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:l="clr-namespace:SimsModManager.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="62" Height="32" Cursor="Hand" ToolTip="{l:Tr 'Коробок · погладь меня (води мышкой туда-сюда)'}">
    <!-- Коробок: перевёрнутая коробка с клапанами-ручками, глазками в вырезах и короткими ножками.
         Все движения — в Mascot.xaml.cs. Координаты рисунка: 120 × 62. -->
    <Viewbox Stretch="Uniform">
        <Canvas x:Name="Root" Width="120" Height="62" Background="Transparent">
            <!-- Ножки (за коробкой — когда спит, коробка оседает и прячет их) -->
            <Rectangle Canvas.Left="34" Canvas.Top="44" Width="11" Height="13" RadiusX="4" RadiusY="4" Fill="#4A5654" />
            <Rectangle Canvas.Left="75" Canvas.Top="44" Width="11" Height="13" RadiusX="4" RadiusY="4" Fill="#4A5654" />

            <Canvas x:Name="Body" Width="120" Height="62">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="Squash" CenterX="60" CenterY="50" />
                        <RotateTransform x:Name="Tilt" CenterX="60" CenterY="50" />
                        <TranslateTransform x:Name="Hop" />
                        <TranslateTransform x:Name="Shake" />
                    </TransformGroup>
                </Canvas.RenderTransform>

                <!-- Клапаны-ручки -->
                <Polygon Points="18,14 3,27 5,35 18,26" Fill="#B07D46">
                    <Polygon.RenderTransform><RotateTransform x:Name="FlapL" CenterX="18" CenterY="16" /></Polygon.RenderTransform>
                </Polygon>
                <Polygon Points="102,14 117,27 115,35 102,26" Fill="#B07D46">
                    <Polygon.RenderTransform><RotateTransform x:Name="FlapR" CenterX="102" CenterY="16" /></Polygon.RenderTransform>
                </Polygon>

                <!-- Коробка и скотч -->
                <Rectangle Canvas.Left="16" Canvas.Top="6" Width="88" Height="42" RadiusX="6" RadiusY="6" Fill="#C9935A" />
                <Rectangle Canvas.Left="16" Canvas.Top="42" Width="88" Height="6" RadiusX="3" RadiusY="3" Fill="#B5824B" />
                <Rectangle Canvas.Left="56" Canvas.Top="6" Width="8" Height="42" Fill="#9E6D3A" />

                <!-- Глазки в вырезах -->
                <Canvas x:Name="EyeL" Canvas.Left="33" Canvas.Top="16" Width="14" Height="16">
                    <Canvas.RenderTransform><ScaleTransform x:Name="BlinkL" CenterX="7" CenterY="8" /></Canvas.RenderTransform>
                    <Ellipse Width="14" Height="16" Fill="#141817" />
                    <Ellipse x:Name="PupilL" Canvas.Left="4" Canvas.Top="4" Width="6" Height="6">
                        <Ellipse.RenderTransform><TranslateTransform x:Name="LookL" /></Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>
                <Canvas x:Name="EyeR" Canvas.Left="73" Canvas.Top="16" Width="14" Height="16">
                    <Canvas.RenderTransform><ScaleTransform x:Name="BlinkR" CenterX="7" CenterY="8" /></Canvas.RenderTransform>
                    <Ellipse Width="14" Height="16" Fill="#141817" />
                    <Ellipse x:Name="PupilR" Canvas.Left="4" Canvas.Top="4" Width="6" Height="6">
                        <Ellipse.RenderTransform><TranslateTransform x:Name="LookR" /></Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>

                <!-- Когда гладят: довольные глазки-дужки и румянец -->
                <Path x:Name="HappyL" Data="M34,27 Q40,19 46,27" Stroke="#141817" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0" />
                <Path x:Name="HappyR" Data="M74,27 Q80,19 86,27" Stroke="#141817" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0" />
                <Ellipse x:Name="BlushL" Canvas.Left="24" Canvas.Top="31" Width="10" Height="5" Fill="#F08FA6" Opacity="0" />
                <Ellipse x:Name="BlushR" Canvas.Left="86" Canvas.Top="31" Width="10" Height="5" Fill="#F08FA6" Opacity="0" />

                <!-- Капелька пота -->
                <Ellipse x:Name="Sweat" Canvas.Left="98" Canvas.Top="2" Width="6" Height="9" Fill="#9AE4FF" Opacity="0">
                    <Ellipse.RenderTransform><TranslateTransform x:Name="SweatDrop" /></Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>

            <!-- Искры радости -->
            <Path x:Name="Spark1" Canvas.Left="0" Canvas.Top="0" Fill="#E9FFF9" Opacity="0" RenderTransformOrigin="0.5,0.5"
                  Data="M6,0 L7.7,4.3 L12,6 L7.7,7.7 L6,12 L4.3,7.7 L0,6 L4.3,4.3 Z" />
            <Path x:Name="Spark2" Canvas.Left="106" Canvas.Top="0" Fill="#82EACF" Opacity="0" RenderTransformOrigin="0.5,0.5"
                  Data="M5,0 L6.4,3.6 L10,5 L6.4,6.4 L5,10 L3.6,6.4 L0,5 L3.6,3.6 Z" />
            <Path x:Name="Spark3" Canvas.Left="110" Canvas.Top="34" Fill="#B8F5E6" Opacity="0" RenderTransformOrigin="0.5,0.5"
                  Data="M4,0 L5.1,2.9 L8,4 L5.1,5.1 L4,8 L2.9,5.1 L0,4 L2.9,2.9 Z" />

            <!-- Сон -->
            <TextBlock x:Name="Zzz" Canvas.Left="100" Canvas.Top="-4" Text="z" FontSize="16" FontWeight="SemiBold" Foreground="#D8D8DE" Opacity="0">
                <TextBlock.RenderTransform><TranslateTransform x:Name="ZzzMove" /></TextBlock.RenderTransform>
            </TextBlock>
        </Canvas>
    </Viewbox>
</UserControl>
