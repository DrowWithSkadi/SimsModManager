<UserControl x:Class="SimsModManager.App.Controls.PlayButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:l="clr-namespace:SimsModManager.App.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SimsModManager.App.Controls"
             Height="44" MinWidth="168">
    <!-- Плавающая кнопка «Играть»: ждёт (градиент сакуры, блик, живой цветок), готовит игру (шаги и прогресс), игра идёт (дышащая точка).
         Состояния переключаются в PlayButton.xaml.cs по свойствам IsLaunching и IsRunning. -->
    <UserControl.Resources>
        <Style x:Key="PlayPart" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Правая часть со стрелкой: своя подсветка, скруглённая как край кнопки -->
        <Style x:Key="MorePart" TargetType="Button" BasedOn="{StaticResource PlayPart}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="0,22,22,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1A17142B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><ScaleTransform x:Name="Press" /></Grid.RenderTransform>

        <!-- Мягкое свечение под кнопкой -->
        <Border x:Name="Glow" CornerRadius="22" Background="{DynamicResource B.Accent}" Margin="8,8,8,0" Opacity="0.3" IsHitTestVisible="False">
            <Border.Effect><BlurEffect Radius="22" /></Border.Effect>
        </Border>

        <!-- ═══ Ждёт ═══ -->
        <Grid x:Name="IdleState">
            <Border x:Name="Pill" CornerRadius="22" Background="{DynamicResource B.Play}" BorderBrush="#99FFFFFF" BorderThickness="1.5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="MainPart" Style="{StaticResource PlayPart}" Click="OnPlay" ToolTip="{l:Tr 'Проверить моды, сделать бэкап сохранений и запустить игру'}">
                        <StackPanel Orientation="Horizontal" Margin="8,0,14,0">
                            <!-- Живая сакура; при наведении поворачивается на один лепесток -->
                            <Grid Width="28" Height="28" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><RotateTransform x:Name="FlowerTurn" /></Grid.RenderTransform>
                                <ctl:SakuraMark />
                            </Grid>
                            <TextBlock Text="{l:Tr 'Играть'}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource B.OnPlay}" VerticalAlignment="Center" />
                            <Path Data="M0,0 L0,10 L8.5,5 Z" Fill="{DynamicResource B.OnPlay}" Margin="8,1,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Grid.Column="1" Width="1" Margin="0,12" HorizontalAlignment="Left" Background="#3317142B" />
                    <Button x:Name="MorePart" Grid.Column="1" Width="38" Style="{StaticResource MorePart}" Click="OnMore" ToolTip="{l:Tr 'Другие варианты запуска'}">
                        <Path Data="M0,0 L5,5 L10,0" Stroke="{DynamicResource B.OnPlay}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Margin="0,0,3,0" />
                    </Button>
                </Grid>
            </Border>
            <!-- Наведение: вся кнопка чуть светлеет (скругление как у кнопки) -->
            <Border x:Name="HoverTint" CornerRadius="22" Background="#2EFFFFFF" Opacity="0" IsHitTestVisible="False" />
            <!-- Блик пробегает по кнопке раз в несколько секунд -->
            <Border CornerRadius="22" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.3" EndPoint="1,0.7">
                        <LinearGradientBrush.RelativeTransform><TranslateTransform x:Name="ShineMove" X="-1.2" /></LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#00FFFFFF" Offset="0.35" />
                        <GradientStop Color="#73FFFFFF" Offset="0.5" />
                        <GradientStop Color="#00FFFFFF" Offset="0.65" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <!-- ═══ Готовит игру ═══ -->
        <Border x:Name="BusyState" CornerRadius="22" Background="{DynamicResource B.PlayRun}" BorderBrush="{DynamicResource B.Accent}" BorderThickness="1.5"
                Visibility="Collapsed" Opacity="0">
            <Grid>
                <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="22" Background="{DynamicResource B.Accent}" Opacity="0.28" />
                <StackPanel Orientation="Horizontal" Margin="14,0,18,0" VerticalAlignment="Center">
                    <!-- Пока игра готовится, сакура кружится -->
                    <ctl:SakuraMark Width="24" Height="24" Spinning="True" />
                    <TextBlock x:Name="StepText" Text="{Binding LaunchStep}" FontSize="13" Foreground="{DynamicResource B.SideText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Игра идёт ═══ -->
        <Border x:Name="RunState" CornerRadius="22" Background="{DynamicResource B.PlayRun}" BorderBrush="#3A3F55" BorderThickness="1.5"
                Visibility="Collapsed" Opacity="0" ToolTip="{l:Tr 'Игра запущена'}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="20" Height="20">
                    <Ellipse x:Name="DotHalo" Fill="{DynamicResource B.Accent}" Opacity="0.25" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="DotPulse" /></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Width="10" Height="10" Fill="{DynamicResource B.Accent}" />
                </Grid>
                <TextBlock Text="{l:Tr 'Игра идёт'}" FontSize="14" Foreground="{DynamicResource B.SideText}" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Меню «другие варианты запуска» -->
        <Popup x:Name="MoreMenu" PlacementTarget="{Binding ElementName=MorePart}" Placement="Top" VerticalOffset="-8" HorizontalOffset="-180"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource B.Popup}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1" CornerRadius="10" Padding="6" Width="230">
                <StackPanel>
                    <Button Style="{StaticResource Btn.Ghost}" HorizontalContentAlignment="Left" ctl:Btn.Icon="{StaticResource Icon.Package}"
                            Content="{l:Tr 'Играть без модов'}" Click="OnPlayNoMods" ToolTip="{l:Tr 'Моды выключатся только на эту игру'}" />
                    <Button Style="{StaticResource Btn.Ghost}" HorizontalContentAlignment="Left" ctl:Btn.Icon="{StaticResource Icon.FileCode}"
                            Content="{l:Tr 'Играть без скриптов'}" Click="OnPlayNoScripts" ToolTip="{l:Tr 'Если игра вылетает — часто виноваты скриптовые моды'}" Margin="0,2,0,0" />
                    <Border Height="1" Background="{DynamicResource B.Hover}" Margin="4,6" />
                    <Button Style="{StaticResource Btn.Ghost}" HorizontalContentAlignment="Left" ctl:Btn.Icon="{StaticResource Icon.FolderOpen}"
                            Content="{l:Tr 'Бэкапы сохранений'}" Click="OnOpenBackups" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
